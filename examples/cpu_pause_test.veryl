#[test(test_cpu_stall_and_halt)]
module test_cpu_stall_and_halt {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var writes        : logic<3> ;
    var result        : logic<8> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'hA9;
            16'h8001: return 8'h12; // LDA #$12
            16'h8002: return 8'h69;
            16'h8003: return 8'h01; // ADC #$01
            16'h8004: return 8'h85;
            16'h8005: return 8'h10; // STA $10
            16'h8006: return 8'hE8; // INX
            16'h8007: return 8'h4C;
            16'h8008: return 8'h07;
            16'h8009: return 8'h80;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            writes       = 0;
            result       = 0;
        } else {
            cpubus.rdata = rom(cpubus.addr);
            if (cpubus.wen && cpubus.addr == 16'h0010) {
                writes = writes + 1;
                result = cpubus.wdata;
                $display("CPU resumed write: count=%d data=%h", writes, cpubus.wdata);
            }
        }
    }
    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(10);
        $display("CPU before stall: pc=%h a=%h", debug_pc, dut.reg_a);
        stall = 1;
        clk.next(5);
        $display("CPU stalled: pc=%h a=%h writes=%d", debug_pc, dut.reg_a, writes);
        $assert(debug_pc == 16'h8002);
        $assert(dut.reg_a == 8'h12);
        $assert(writes == 0);
        stall = 0;
        clk.next(35);
        $assert(result == 8'h13);
        $assert(writes == 1);
        $assert(dut.reg_x == 8'h01);
        $assert(debug_pc == 16'h8007);
        halt = 1;
        clk.next(6);
        $display("CPU halted: pc=%h a=%h x=%h writes=%d", debug_pc, dut.reg_a, dut.reg_x, writes);
        $assert(debug_pc == 16'h8007);
        $assert(dut.reg_a == 8'h13);
        $assert(dut.reg_x == 8'h01);
        $assert(writes == 1);
        $finish();
    }
}
