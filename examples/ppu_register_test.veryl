#[test(test_ppu_registers_and_vram_access)]
module test_ppu_registers_and_vram_access {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var frame_sync              : logic   ;
    var scanline                : logic<9>;
    var cycle                   : logic<9>;
    var pixel_index             : logic<6>;
    var nmi                     : logic   ;
    var frame_wait              : logic   ;
    var debug_palette0          : logic<8>;
    var debug_palette1          : logic<8>;
    var debug_palette2          : logic<8>;
    var debug_palette3          : logic<8>;
    var debug_bg_palette_addr   : logic<5>;
    var debug_bg_palette_data   : logic<8>;
    var debug_palette_write     : logic   ;
    var debug_palette_write_addr: logic<5>;
    var debug_palette_write_data: logic<8>;

    inst cpubus: bus_if::<8, 3>;
    inst ppubus: bus_if::<8, 14>;

    inst dut: ppu (
        clk                     : clk                     ,
        rst                     : rst                     ,
        frame_sync              : frame_sync              ,
        cpubus                  : cpubus                  ,
        ppubus                  : ppubus                  ,
        scanline                : scanline                ,
        cycle                   : cycle                   ,
        pixel_index             : pixel_index             ,
        nmi                     : nmi                     ,
        frame_wait              : frame_wait              ,
        debug_palette0          : debug_palette0          ,
        debug_palette1          : debug_palette1          ,
        debug_palette2          : debug_palette2          ,
        debug_palette3          : debug_palette3          ,
        debug_bg_palette_addr   : debug_bg_palette_addr   ,
        debug_bg_palette_data   : debug_bg_palette_data   ,
        debug_palette_write     : debug_palette_write     ,
        debug_palette_write_addr: debug_palette_write_addr,
        debug_palette_write_data: debug_palette_write_data,
    );

    function write_register (
        addr: input logic<3>,
        data: input logic<8>,
    ) {
        cpubus.addr  = addr;
        cpubus.wdata = data;
        cpubus.wen   = 1;
        clk.next();
        cpubus.wen  = 0;
        cpubus.addr = 0;
        clk.next();
    }

    function set_ppu_addr (
        addr: input logic<16>,
    ) {
        write_register(6, addr[15:8]);
        write_register(6, addr[7:0]);
    }

    initial {
        frame_sync  = 0;
        cpubus.addr = 0;
        cpubus.wen  = 0;
        cpubus.wdata = 0;
        ppubus.rdata = 0;

        rst.assert();

        // $2005 alternates between horizontal and vertical scroll fields.
        write_register(5, 8'h2D);
        $assert(dut.reg_w);
        $assert(dut.reg_t[4:0] == 5'd5);
        $assert(dut.fine_x_scroll == 3'd5);
        write_register(5, 8'h53);
        $assert(!dut.reg_w);
        $assert(dut.reg_t[9:5] == 5'd10);
        $assert(dut.reg_t[14:12] == 3'd3);

        // $2006 loads the 16-bit VRAM address in two writes.
        set_ppu_addr(16'h2123);
        $display("PPU address latch: t=%h v=%h", dut.reg_t, dut.reg_v);
        $assert(dut.reg_v == 16'h2123);
        $assert(!dut.reg_w);

        // Non-palette $2007 writes are sent to the external PPU bus.
        cpubus.addr  = 7;
        cpubus.wdata = 8'hA5;
        cpubus.wen   = 1;
        $assert(ppubus.addr == 14'h2123);
        $assert(ppubus.wen);
        $assert(ppubus.wdata == 8'hA5);
        clk.next();
        cpubus.wen  = 0;
        cpubus.addr = 0;
        clk.next();
        $assert(dut.reg_v == 16'h2124);

        // PPUCTRL bit 2 selects an increment of 32 instead of 1.
        write_register(0, 8'h04);
        set_ppu_addr(16'h2400);
        write_register(7, 8'h5A);
        $assert(dut.reg_v == 16'h2420);

        // Palette writes stay internal; $3F10 mirrors universal color $3F00.
        set_ppu_addr(16'h3F10);
        cpubus.addr  = 7;
        cpubus.wdata = 8'h2A;
        cpubus.wen   = 1;
        $assert(!ppubus.wen);
        clk.next();
        cpubus.wen  = 0;
        cpubus.addr = 0;
        clk.next();
        $display("PPU palette mirror: palette[00]=%h", dut.palette_ram[0]);
        $assert(dut.palette_ram[0] == 8'h2A);
        $assert(dut.reg_v == 16'h3F30);

        // Palette reads are immediate and use the same mirror mapping.
        write_register(0, 8'h00);
        set_ppu_addr(16'h3F00);
        cpubus.addr = 7;
        cpubus.wen  = 0;
        clk.next();
        $assert(cpubus.rdata == 8'h2A);
        $assert(dut.reg_v == 16'h3F01);
        cpubus.addr = 0;
        clk.next();

        // A status read clears the shared $2005/$2006 write latch.
        write_register(5, 8'h18);
        $assert(dut.reg_w);
        cpubus.addr = 2;
        clk.next();
        cpubus.addr = 0;
        clk.next();
        $assert(!dut.reg_w);

        $finish();
    }
}
