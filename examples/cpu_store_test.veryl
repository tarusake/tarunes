#[test(test_cpu_store_addressing)]
module test_cpu_store_addressing {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var checks        : logic<4> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function mem_data (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'hA9;
            16'h8001: return 8'hA1;
            16'h8002: return 8'hA2;
            16'h8003: return 8'h04;
            16'h8004: return 8'hA0;
            16'h8005: return 8'h03;
            16'h8006: return 8'h95;
            16'h8007: return 8'h20; // STA $20,X
            16'h8008: return 8'h9D;
            16'h8009: return 8'h00;
            16'h800A: return 8'h10; // STA $1000,X
            16'h800B: return 8'h99;
            16'h800C: return 8'h00;
            16'h800D: return 8'h11; // STA $1100,Y
            16'h800E: return 8'h81;
            16'h800F: return 8'h50; // STA ($50,X)
            16'h8010: return 8'h91;
            16'h8011: return 8'h60; // STA ($60),Y
            16'h8012: return 8'h96;
            16'h8013: return 8'h30; // STX $30,Y
            16'h8014: return 8'h94;
            16'h8015: return 8'h40; // STY $40,X
            16'h8016: return 8'h8E;
            16'h8017: return 8'h00;
            16'h8018: return 8'h14; // STX $1400
            16'h8019: return 8'h8C;
            16'h801A: return 8'h00;
            16'h801B: return 8'h15; // STY $1500
            16'h801C: return 8'h4C;
            16'h801D: return 8'h1C;
            16'h801E: return 8'h80;
            16'h0054: return 8'h00;
            16'h0055: return 8'h12;
            16'h0060: return 8'h00;
            16'h0061: return 8'h13;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            checks       = 0;
        } else {
            cpubus.rdata = mem_data(cpubus.addr);
            if (cpubus.wen) {
                case (cpubus.addr) {
                    16'h0024, 16'h1004, 16'h1103, 16'h1200, 16'h1303: {
                        $assert(cpubus.wdata == 8'hA1);
                        checks = checks + 1;
                    }
                    16'h0033, 16'h1400: {
                        $assert(cpubus.wdata == 8'h04);
                        checks = checks + 1;
                    }
                    16'h0044, 16'h1500: {
                        $assert(cpubus.wdata == 8'h03);
                        checks = checks + 1;
                    }
                    default: {
                        $assert(0);
                    }
                }
                $display("Store write: addr=%h data=%h", cpubus.addr, cpubus.wdata);
            }
        }
    }
    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(180);
        $display("Store summary: pc=%h checks=%d", debug_pc, checks);
        $assert(checks == 9);
        $assert(debug_pc == 16'h801C);
        $finish();
    }
}
