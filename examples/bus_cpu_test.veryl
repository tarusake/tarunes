#[test(test_bus_cpu_decode)]
module test_bus_cpu_decode {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);

    var stall    : logic   ;
    var dma_busy : logic   ;
    var dma_start: logic   ;
    var dma_page : logic<8>;
    var cpu_halt : logic   ;

    inst cpubus     : bus_if::<8, 16>;
    inst cpu_ppubus : bus_if::<8, 3>;
    inst dma_ppubus : bus_if::<8, 3>;
    inst apubus     : bus_if::<8, 5>;
    inst ctrlbus    : bus_if::<8, 1>;
    inst dma_wrambus: bus_if::<8, 11>;
    inst wrambus    : bus_if::<8, 11>;
    inst prombus    : bus_if::<8, 15>;

    inst dut: bus_cpu (
        clk        : clk        ,
        rst        : rst        ,
        stall      : stall      ,
        dma_busy   : dma_busy   ,
        dma_start  : dma_start  ,
        dma_page   : dma_page   ,
        cpu_halt   : cpu_halt   ,
        cpubus     : cpubus     ,
        cpu_ppubus : cpu_ppubus ,
        dma_ppubus : dma_ppubus ,
        apubus     : apubus     ,
        ctrlbus    : ctrlbus    ,
        dma_wrambus: dma_wrambus,
        wrambus    : wrambus    ,
        prombus    : prombus    ,
    );

    initial {
        stall               = 0;
        dma_busy            = 0;
        cpubus.addr         = 0;
        cpubus.wen          = 0;
        cpubus.wdata        = 0;
        cpu_ppubus.rdata    = 8'h22;
        dma_ppubus.addr     = 3'h4;
        dma_ppubus.wen      = 1;
        dma_ppubus.wdata    = 8'hDD;
        apubus.rdata        = 8'h44;
        ctrlbus.rdata       = 8'h66;
        dma_wrambus.addr    = 11'h321;
        dma_wrambus.wen     = 0;
        dma_wrambus.wdata   = 8'hCC;
        wrambus.rdata       = 8'h88;
        prombus.rdata       = 8'hAA;

        rst.assert();

        cpubus.addr  = 16'h17FF;
        cpubus.wen   = 1;
        cpubus.wdata = 8'h5A;
        $display("CPU bus WRAM: addr=%h mapped=%h data=%h", cpubus.addr, wrambus.addr, wrambus.wdata);
        $assert(wrambus.addr == 11'h7FF);
        $assert(wrambus.wen);
        $assert(wrambus.wdata == 8'h5A);

        cpubus.addr = 16'h2007;
        $display("CPU bus PPU: addr=%h mapped=%h", cpubus.addr, cpu_ppubus.addr);
        $assert(cpu_ppubus.addr == 3'h7);
        $assert(cpu_ppubus.wen);

        cpubus.addr = 16'h4015;
        $assert(apubus.addr == 5'h15);
        $assert(apubus.wen);

        cpubus.addr = 16'h4016;
        $assert(ctrlbus.addr == 0);
        $assert(ctrlbus.wen);

        cpubus.addr = 16'h8001;
        cpubus.wen  = 0;
        clk.next();
        $display("CPU bus PROM read: mapped=%h data=%h", prombus.addr, cpubus.rdata);
        $assert(prombus.addr == 15'h0001);
        $assert(cpubus.rdata == 8'hAA);

        cpubus.addr  = 16'h4014;
        cpubus.wen   = 1;
        cpubus.wdata = 8'h23;
        $display("CPU bus DMA request: start=%b page=%h halt=%b", dma_start, dma_page, cpu_halt);
        $assert(dma_start);
        $assert(dma_page == 8'h23);
        $assert(cpu_halt);
        clk.next();
        $assert(!dma_start);

        dma_busy = 1;
        cpubus.wen = 0;
        $display("CPU bus DMA routing: wram=%h ppu=%h", wrambus.addr, cpu_ppubus.addr);
        $assert(cpu_halt);
        $assert(wrambus.addr == 11'h321);
        $assert(cpu_ppubus.addr == 3'h4);
        $assert(cpu_ppubus.wen);
        $assert(cpu_ppubus.wdata == 8'hDD);

        $finish();
    }
}
