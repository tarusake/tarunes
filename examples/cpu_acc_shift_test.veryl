#[test(test_cpu_accumulator_shift_rotate)]
module test_cpu_accumulator_shift_rotate {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var result_count  : logic<3> ;
    var flag_count    : logic<3> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'hA9;
            16'h8001: return 8'h80;
            16'h8002: return 8'h0A;
            16'h8003: return 8'h85;
            16'h8004: return 8'h10;
            16'h8005: return 8'h08;
            16'h8006: return 8'hA9;
            16'h8007: return 8'h01;
            16'h8008: return 8'h4A;
            16'h8009: return 8'h85;
            16'h800A: return 8'h11;
            16'h800B: return 8'h08;
            16'h800C: return 8'h18;
            16'h800D: return 8'hA9;
            16'h800E: return 8'h80;
            16'h800F: return 8'h2A;
            16'h8010: return 8'h85;
            16'h8011: return 8'h12;
            16'h8012: return 8'h08;
            16'h8013: return 8'h38;
            16'h8014: return 8'hA9;
            16'h8015: return 8'h00;
            16'h8016: return 8'h2A;
            16'h8017: return 8'h85;
            16'h8018: return 8'h13;
            16'h8019: return 8'h08;
            16'h801A: return 8'h18;
            16'h801B: return 8'hA9;
            16'h801C: return 8'h01;
            16'h801D: return 8'h6A;
            16'h801E: return 8'h85;
            16'h801F: return 8'h14;
            16'h8020: return 8'h08;
            16'h8021: return 8'h38;
            16'h8022: return 8'hA9;
            16'h8023: return 8'h00;
            16'h8024: return 8'h6A;
            16'h8025: return 8'h85;
            16'h8026: return 8'h15;
            16'h8027: return 8'h08;
            16'h8028: return 8'h4C;
            16'h8029: return 8'h28;
            16'h802A: return 8'h80;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            result_count = 0;
            flag_count   = 0;
        } else {
            cpubus.rdata = rom(cpubus.addr);
            if (cpubus.wen) {
                case (cpubus.addr) {
                    16'h0010, 16'h0011, 16'h0012, 16'h0014: {
                        $assert(cpubus.wdata == 0);
                        result_count = result_count + 1;
                    }
                    16'h0013: {
                        $assert(cpubus.wdata == 8'h01);
                        result_count = result_count + 1;
                    }
                    16'h0015: {
                        $assert(cpubus.wdata == 8'h80);
                        result_count = result_count + 1;
                    }
                    16'h01FD, 16'h01FC, 16'h01FB, 16'h01F9: {
                        $assert(cpubus.wdata == 8'h37);
                        flag_count = flag_count + 1;
                    }
                    16'h01FA: {
                        $assert(cpubus.wdata == 8'h34);
                        flag_count = flag_count + 1;
                    }
                    16'h01F8: {
                        $assert(cpubus.wdata == 8'hB4);
                        flag_count = flag_count + 1;
                    }
                    default: {}
                }
                $display("Accumulator shift write: addr=%h data=%h", cpubus.addr, cpubus.wdata);
            }
        }
    }
    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(180);
        $display("Accumulator shift summary: pc=%h results=%d flags=%d", debug_pc, result_count, flag_count);
        $assert(result_count == 6);
        $assert(flag_count == 6);
        $assert(debug_pc == 16'h8028);
        $finish();
    }
}
