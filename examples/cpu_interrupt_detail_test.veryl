#[test(test_cpu_interrupt_details)]
module test_cpu_interrupt_details {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var brk_phase     : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var stack_fd      : logic<8> ;
    var stack_fc      : logic<8> ;
    var stack_fb      : logic<8> ;
    var nmi_push_count: logic<3> ;
    var brk_push_count: logic<3> ;
    var early_push    : logic    ;
    var nmi_done      : logic    ;
    var brk_done      : logic    ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'hFFFA: return 8'h00;
            16'hFFFB: return 8'h90;
            16'hFFFE: return 8'h00;
            16'hFFFF: return 8'h91;
            16'h8000: return 8'hAD;
            16'h8001: return 8'h34;
            16'h8002: return 8'h12; // LDA $1234
            16'h8003: return 8'h4C;
            16'h8004: return 8'h03;
            16'h8005: return 8'h80;
            16'h8010: return 8'h00;
            16'h8011: return 8'hEA; // BRK + padding
            16'h8012: return 8'h4C;
            16'h8013: return 8'h12;
            16'h8014: return 8'h80;
            16'h1234: return 8'h5A;
            16'h9000: return 8'h85;
            16'h9001: return 8'h20;
            16'h9002: return 8'h40;
            16'h9100: return 8'hA9;
            16'h9101: return 8'hB6;
            16'h9102: return 8'h85;
            16'h9103: return 8'h21;
            16'h9104: return 8'h40;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata   = 0;
            stack_fd       = 0;
            stack_fc       = 0;
            stack_fb       = 0;
            nmi_push_count = 0;
            brk_push_count = 0;
            early_push     = 0;
            nmi_done       = 0;
            brk_done       = 0;
        } else {
            case (cpubus.addr) {
                16'h01FD: {
                    cpubus.rdata = stack_fd;
                }
                16'h01FC: {
                    cpubus.rdata = stack_fc;
                }
                16'h01FB: {
                    cpubus.rdata = stack_fb;
                }
                default: {
                    if (brk_phase && cpubus.addr == 16'h8003) {
                        cpubus.rdata = 8'h4C;
                    } else if (brk_phase && cpubus.addr == 16'h8004) {
                        cpubus.rdata = 8'h10;
                    } else if (brk_phase && cpubus.addr == 16'h8005) {
                        cpubus.rdata = 8'h80;
                    } else {
                        cpubus.rdata = rom(cpubus.addr);
                    }
                }
            }
            if (cpubus.wen) {
                case (cpubus.addr) {
                    16'h01FD: {
                        stack_fd = cpubus.wdata;
                        if (brk_phase) {
                            brk_push_count = brk_push_count + 1;
                        } else {
                            nmi_push_count = nmi_push_count + 1;
                        }
                    }
                    16'h01FC: {
                        stack_fc = cpubus.wdata;
                        if (brk_phase) {
                            brk_push_count = brk_push_count + 1;
                        } else {
                            nmi_push_count = nmi_push_count + 1;
                        }
                    }
                    16'h01FB: {
                        stack_fb = cpubus.wdata;
                        if (brk_phase) {
                            brk_push_count = brk_push_count + 1;
                        } else {
                            nmi_push_count = nmi_push_count + 1;
                        }
                    }
                    16'h0020: {
                        nmi_done = cpubus.wdata == 8'h5A;
                    }
                    16'h0021: {
                        brk_done = cpubus.wdata == 8'hB6;
                    }
                    default: {}
                }
            }
            if (nmi && nmi_push_count != 0) {
                early_push = 1;
            }
        }
    }
    initial {
        stall     = 0;
        nmi       = 0;
        halt      = 0;
        brk_phase = 0;
        rst.assert();
        // LDA absoluteのオペランド取得中に1クロックだけNMIを入力する。
        clk.next(6);
        nmi = 1;
        clk.next(1);
        nmi = 0;
        clk.next(50);
        $display(
            "NMI detail: pc=%h stack=%h,%h,%h pushes=%d early=%b",
            debug_pc,
            stack_fd,
            stack_fc,
            stack_fb,
            nmi_push_count,
            early_push,
        );
        $assert(!early_push);
        $assert(nmi_done);
        $assert(nmi_push_count == 3);
        $assert(stack_fd == 8'h80);
        $assert(stack_fc == 8'h03);
        $assert(stack_fb == 8'h24);
        $assert(dut.reg_a == 8'h5A);
        $assert(dut.reg_sp == 8'hFD);

        brk_phase = 1;
        clk.next(70);
        $display("BRK detail: pc=%h stack=%h,%h,%h pushes=%d", debug_pc, stack_fd, stack_fc, stack_fb, brk_push_count);
        $assert(brk_done);
        $assert(brk_push_count == 3);
        $assert(stack_fd == 8'h80);
        $assert(stack_fc == 8'h12);
        $assert(stack_fb == 8'h34);
        $assert(dut.reg_sp == 8'hFD);
        $assert(debug_pc == 16'h8012);
        $finish();
    }
}
