#[test(test_cpu_read_modify_write)]
module test_cpu_read_modify_write {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var m20           : logic<8> ;
    var m21           : logic<8> ;
    var m22           : logic<8> ;
    var m23           : logic<8> ;
    var m24           : logic<8> ;
    var m25           : logic<8> ;
    var writes        : logic<4> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'hE6;
            16'h8001: return 8'h20; // INC $20
            16'h8002: return 8'hC6;
            16'h8003: return 8'h21; // DEC $21
            16'h8004: return 8'h06;
            16'h8005: return 8'h22; // ASL $22
            16'h8006: return 8'h46;
            16'h8007: return 8'h23; // LSR $23
            16'h8008: return 8'h18; // CLC
            16'h8009: return 8'h26;
            16'h800A: return 8'h24; // ROL $24
            16'h800B: return 8'h38; // SEC
            16'h800C: return 8'h66;
            16'h800D: return 8'h25; // ROR $25
            16'h800E: return 8'h4C;
            16'h800F: return 8'h0E;
            16'h8010: return 8'h80;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            m20          = 8'h7F;
            m21          = 8'h00;
            m22          = 8'h81;
            m23          = 8'h03;
            m24          = 8'h80;
            m25          = 8'h02;
            writes       = 0;
        } else {
            case (cpubus.addr) {
                16'h0020: {
                    cpubus.rdata = m20;
                }
                16'h0021: {
                    cpubus.rdata = m21;
                }
                16'h0022: {
                    cpubus.rdata = m22;
                }
                16'h0023: {
                    cpubus.rdata = m23;
                }
                16'h0024: {
                    cpubus.rdata = m24;
                }
                16'h0025: {
                    cpubus.rdata = m25;
                }
                default: {
                    cpubus.rdata = rom(cpubus.addr);
                }
            }
            if (cpubus.wen && cpubus.addr >= 16'h0020 && cpubus.addr <= 16'h0025) {
                case (cpubus.addr) {
                    16'h0020: {
                        m20 = cpubus.wdata;
                    }
                    16'h0021: {
                        m21 = cpubus.wdata;
                    }
                    16'h0022: {
                        m22 = cpubus.wdata;
                    }
                    16'h0023: {
                        m23 = cpubus.wdata;
                    }
                    16'h0024: {
                        m24 = cpubus.wdata;
                    }
                    16'h0025: {
                        m25 = cpubus.wdata;
                    }
                    default: {}
                }
                writes = writes + 1;
                $display("RMW write: addr=%h data=%h", cpubus.addr, cpubus.wdata);
            }
        }
    }
    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(140);
        $display("RMW summary: %h %h %h %h %h %h writes=%d p=%h", m20, m21, m22, m23, m24, m25, writes, dut.reg_p);
        $assert(m20 == 8'h80);
        $assert(m21 == 8'hFF);
        $assert(m22 == 8'h02);
        $assert(m23 == 8'h01);
        $assert(m24 == 8'h00);
        $assert(m25 == 8'h81);
        $assert(writes == 12);
        $assert(!dut.reg_p[0] && !dut.reg_p[1] && dut.reg_p[7]);
        $assert(debug_pc == 16'h800E);
        $finish();
    }
}
