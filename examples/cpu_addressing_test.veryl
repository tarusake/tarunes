#[test(test_cpu_addressing_modes)]
module test_cpu_addressing_modes {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall: logic; var nmi: logic; var halt: logic;
    var debug_pc: logic<16>; var logic_analizer: logic<16>;
    var checks: logic<4>;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk: clk, rst: rst, stall: stall, nmi: nmi, halt: halt,
        debug_pc: debug_pc, logic_analizer: logic_analizer, cpubus: cpubus,
    );

    function mem_data (addr: input logic<16>) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00; 16'hFFFD: return 8'h80;
            16'h8000: return 8'hA2; 16'h8001: return 8'h04; // LDX #4
            16'h8002: return 8'hA0; 16'h8003: return 8'h03; // LDY #3
            16'h8004: return 8'hA5; 16'h8005: return 8'h20; // LDA $20
            16'h8006: return 8'h85; 16'h8007: return 8'h40;
            16'h8008: return 8'hB5; 16'h8009: return 8'h20; // LDA $20,X
            16'h800A: return 8'h85; 16'h800B: return 8'h41;
            16'h800C: return 8'hAD; 16'h800D: return 8'h90; 16'h800E: return 8'h00; // LDA $0090
            16'h800F: return 8'h85; 16'h8010: return 8'h42;
            16'h8011: return 8'hBD; 16'h8012: return 8'h90; 16'h8013: return 8'h00; // LDA $0090,X
            16'h8014: return 8'h85; 16'h8015: return 8'h43;
            16'h8016: return 8'hB9; 16'h8017: return 8'h90; 16'h8018: return 8'h00; // LDA $0090,Y
            16'h8019: return 8'h85; 16'h801A: return 8'h44;
            16'h801B: return 8'hA1; 16'h801C: return 8'h50; // LDA ($50,X)
            16'h801D: return 8'h85; 16'h801E: return 8'h45;
            16'h801F: return 8'hB1; 16'h8020: return 8'h60; // LDA ($60),Y
            16'h8021: return 8'h85; 16'h8022: return 8'h46;
            16'h8023: return 8'hB6; 16'h8024: return 8'h20; // LDX $20,Y
            16'h8025: return 8'h86; 16'h8026: return 8'h47;
            16'h8027: return 8'h4C; 16'h8028: return 8'h27; 16'h8029: return 8'h80;
            16'h0020: return 8'h11; 16'h0023: return 8'h88; 16'h0024: return 8'h22;
            16'h0054: return 8'hA0; 16'h0055: return 8'h00;
            16'h0060: return 8'hB0; 16'h0061: return 8'h00;
            16'h0090: return 8'h33; 16'h0094: return 8'h44; 16'h0093: return 8'h55;
            16'h00A0: return 8'h66; 16'h00B3: return 8'h77;
            default: return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset { cpubus.rdata = 0; checks = 0; }
        else {
            cpubus.rdata = mem_data(cpubus.addr);
            if (cpubus.wen && cpubus.addr >= 16'h0040 && cpubus.addr <= 16'h0047) {
                case (cpubus.addr) {
                    16'h0040: { $assert(cpubus.wdata == 8'h11); }
                    16'h0041: { $assert(cpubus.wdata == 8'h22); }
                    16'h0042: { $assert(cpubus.wdata == 8'h33); }
                    16'h0043: { $assert(cpubus.wdata == 8'h44); }
                    16'h0044: { $assert(cpubus.wdata == 8'h55); }
                    16'h0045: { $assert(cpubus.wdata == 8'h66); }
                    16'h0046: { $assert(cpubus.wdata == 8'h77); }
                    16'h0047: { $assert(cpubus.wdata == 8'h88); }
                    default: {}
                }
                $display("Addressing result: slot=%h data=%h", cpubus.addr, cpubus.wdata);
                checks = checks + 1;
            }
        }
    }
    initial {
        stall = 0; nmi = 0; halt = 0; rst.assert(); clk.next(180);
        $display("Addressing summary: pc=%h checks=%d", debug_pc, checks);
        $assert(checks == 8); $assert(debug_pc == 16'h8027); $finish();
    }
}
