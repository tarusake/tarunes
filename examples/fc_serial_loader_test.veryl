#[test(test_fc_serial_loader_board_model)]
module test_fc_serial_loader_board_model {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var cart_miso    : logic    ;
    var cart_sclk    : logic    ;
    var cart_mosi    : logic    ;
    var cart_rclk    : logic    ;
    var cart_pl_n    : logic    ;
    var cart_pwr_en  : logic    ;
    var done         : logic    ;
    var prg_load_wen : logic    ;
    var prg_load_addr: logic<15>;
    var chr_load_wen : logic    ;
    var chr_load_addr: logic<13>;
    var load_data    : logic<8> ;

    inst dut: fc_serial_loader #(
        POWER_WAIT_CYCLES : 2,
        ACCESS_WAIT_CYCLES: 1,
        PRG_LAST_ADDR     : 1,
        CHR_LAST_ADDR     : 1,
    ) (
        clk            ,
        rst            ,
        cart_miso      ,
        cart_sclk      ,
        cart_mosi      ,
        cart_rclk      ,
        cart_pl_n      ,
        cart_pwr_en    ,
        done           ,
        prg_load_wen   ,
        prg_load_addr  ,
        chr_load_wen   ,
        chr_load_addr  ,
        load_data      ,
    );

    initial {
        var previous_sclk: logic    ;
        var previous_rclk: logic    ;
        var previous_pl_n: logic    ;
        var output_shift : logic<40>;
        var output_latch : logic<40>;
        var input_shift  : logic<16>;
        var shift_count  : logic<7> ;
        var cycles_since : logic<4> ;
        var prg_writes   : logic<3> ;
        var chr_writes   : logic<3> ;
        var cpu_byte     : logic<8> ;
        var ppu_byte     : logic<8> ;

        cart_miso = 0;
        rst.assert();
        $assert(!cart_pwr_en && cart_sclk && cart_rclk && !cart_pl_n);

        previous_sclk = cart_sclk;
        previous_rclk = cart_rclk;
        previous_pl_n = cart_pl_n;
        output_shift  = 0;
        output_latch  = 0;
        input_shift   = 0;
        shift_count   = 0;
        cycles_since  = 0;
        prg_writes    = 0;
        chr_writes    = 0;
        cpu_byte      = 0;
        ppu_byte      = 0;

        for i in 0..1200 {
            clk.next();
            cycles_since = cycles_since + 1;

            // VHCT540 inversion: falling at the FPGA pin is rising at the
            // 74HC595/165 clocks. Both chains shift on this edge.
            if previous_sclk && !cart_sclk {
                if shift_count != 0 && shift_count <: 40 {
                    $assert(cycles_since == 4);
                }
                cycles_since = 0;
                output_shift = {output_shift[38:0], !cart_mosi};
                if shift_count <: 40 {
                    shift_count = shift_count + 1;
                } else if !cart_pl_n {
                    input_shift = {1'b0, input_shift[15:1]};
                }
            }

            // The inverting buffer turns a falling FPGA RCLK into the 595
            // storage-register rising edge.
            if previous_rclk && !cart_rclk {
                output_latch = output_shift;
                shift_count  = 7'd40;
            }

            // A rising FPGA /PL is the active-low parallel load at the 165s.
            if !previous_pl_n && cart_pl_n {
                if !output_latch[17] && output_latch[16] {
                    cpu_byte = output_latch[7:0] ^ 8'hA5;
                } else {
                    cpu_byte = 0;
                }
                if !output_latch[32] {
                    ppu_byte = output_latch[25:18] ^ 8'h3C;
                } else {
                    ppu_byte = 0;
                }
                // The PCB reverses the 165 parallel pins so QH emits CPU
                // D0..D7 followed by PPU D0..D7.
                input_shift = {ppu_byte, cpu_byte};
                shift_count = 7'd40;
            }

            cart_miso = input_shift[0];
            if prg_load_wen {
                $display("FC board model PRG[%h]=%h", prg_load_addr, load_data);
                $assert(prg_load_addr == {12'b000000000000, prg_writes});
                $assert(load_data == ({5'b00000, prg_writes} ^ 8'hA5));
                $assert(!chr_load_wen);
                prg_writes = prg_writes + 1;
            }
            if chr_load_wen {
                $display("FC board model CHR[%h]=%h", chr_load_addr, load_data);
                $assert(chr_load_addr == {10'b0000000000, chr_writes});
                $assert(load_data == ({5'b00000, chr_writes} ^ 8'h3C));
                chr_writes = chr_writes + 1;
            }

            previous_sclk = cart_sclk;
            previous_rclk = cart_rclk;
            previous_pl_n = cart_pl_n;
            if done {
                break;
            }
        }
        $assert(prg_writes == 2);
        $assert(chr_writes == 2);
        $assert(done && !cart_pwr_en);
        $finish();
    }
}
