/// CPU命令デコードの読み方を確認する単体テスト。
///
/// 1つのオペコードは、次の3つの情報へ変換される。
///
/// - `inst_kind`: LDAやADCなど、実行する命令
/// - `mode`: 即値、ゼロページ、絶対などのアドレッシングモード
/// - `len`: オペコードを含む命令全体のバイト数
///
/// CPU本体の動作テストとは分け、ここでは全対応オペコードが正しく
///デコードできることを一括で確認する。
#[test(test_all_cpu_instruction_decodes)]
module test_all_cpu_instruction_decodes {
    import cpu_pkg::*;

    var last_instruction: inst_t;

    function instruction_name (
        instruction: input inst_t,
    ) -> logic<24> {
        case (instruction) {
            inst_t::BRK: return "BRK";
            inst_t::RTI: return "RTI";
            inst_t::PHA: return "PHA";
            inst_t::PLA: return "PLA";
            inst_t::PHP: return "PHP";
            inst_t::PLP: return "PLP";
            inst_t::SEI: return "SEI";
            inst_t::SEC: return "SEC";
            inst_t::CLI: return "CLI";
            inst_t::CLD: return "CLD";
            inst_t::CLC: return "CLC";
            inst_t::SED: return "SED";
            inst_t::CLV: return "CLV";
            inst_t::NOP: return "NOP";
            inst_t::TXS: return "TXS";
            inst_t::TSX: return "TSX";
            inst_t::TAX: return "TAX";
            inst_t::TXA: return "TXA";
            inst_t::TAY: return "TAY";
            inst_t::TYA: return "TYA";
            inst_t::INX: return "INX";
            inst_t::INY: return "INY";
            inst_t::INC: return "INC";
            inst_t::DEC: return "DEC";
            inst_t::ASL: return "ASL";
            inst_t::LSR: return "LSR";
            inst_t::ROL: return "ROL";
            inst_t::ROR: return "ROR";
            inst_t::DEX: return "DEX";
            inst_t::DEY: return "DEY";
            inst_t::LDA: return "LDA";
            inst_t::LDX: return "LDX";
            inst_t::LDY: return "LDY";
            inst_t::CPX: return "CPX";
            inst_t::CPY: return "CPY";
            inst_t::CMP: return "CMP";
            inst_t::ADC: return "ADC";
            inst_t::SBC: return "SBC";
            inst_t::ORA: return "ORA";
            inst_t::AND: return "AND";
            inst_t::EOR: return "EOR";
            inst_t::STA: return "STA";
            inst_t::STX: return "STX";
            inst_t::STY: return "STY";
            inst_t::BIT: return "BIT";
            inst_t::BCC: return "BCC";
            inst_t::BCS: return "BCS";
            inst_t::BNE: return "BNE";
            inst_t::BEQ: return "BEQ";
            inst_t::BPL: return "BPL";
            inst_t::BMI: return "BMI";
            inst_t::BVC: return "BVC";
            inst_t::BVS: return "BVS";
            inst_t::JMP: return "JMP";
            inst_t::JSR: return "JSR";
            inst_t::RTS: return "RTS";
            default    : return "???";
        }
    }

    initial {
        last_instruction = inst_t::INVALID;

        // DECODE_TABLEの全エントリをdecode_opcodeへ入力する。
        // 新しい命令をテーブルへ追加すると、このループの対象にも自動で加わる。
        for i in 0..$size(DECODE_TABLE) {
            let expected: decode_entry_t = DECODE_TABLE[i];
            let actual  : decode_entry_t = decode_opcode(expected.opcode);

            // 命令が切り替わった時点で、直前の命令の全モードが確認済みになる。
            if expected.inst_kind != last_instruction {
                if last_instruction != inst_t::INVALID {
                    $display("%s decode: OK", instruction_name(last_instruction));
                }
                last_instruction = expected.inst_kind;
            }

            $assert(actual.opcode == expected.opcode);
            $assert(actual.inst_kind == expected.inst_kind);
            $assert(actual.mode == expected.mode);
            $assert(actual.len == expected.len);
        }

        // 最後の命令は次の命令への切り替わりがないため、ループ後に表示する。
        $display("%s decode: OK", instruction_name(last_instruction));
        $display("CPU decode: all %d opcodes passed", $size(DECODE_TABLE));
        $finish();
    }
}

/// DECODE_TABLEにある151オペコードを、表だけでなくCPU本体へ1つずつ入力する。
///
/// 各回でCPUをリセットして同じアドレスから対象命令を開始するため、前の命令が
/// レジスタやPCへ与えた影響を持ち越さない。詳細な演算結果は後続の命令別テストで
/// 確認し、このテストでは「対応を宣言したのにCPUでは実行できない」漏れを検出する。
#[test(test_all_cpu_opcodes_execute)]
module test_all_cpu_opcodes_execute {
    import cpu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stall               : logic    ;
    var nmi                 : logic    ;
    var halt                : logic    ;
    var debug_pc            : logic<16>;
    var logic_analizer      : logic<16>;
    var test_opcode         : logic<8> ;
    var opcode_seen         : logic    ;
    var instruction_finished: logic    ;

    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function memory (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'hFFFE: return 8'h03; // BRK後も安全な停止ループへ移動する。
            16'hFFFF: return 8'h80;
            16'h8000: return test_opcode;
            16'h8001: return 8'h20; // 8ビットオペランド、または下位アドレス
            16'h8002: return 8'h00; // 上位アドレス
            16'h8003: return 8'h4C; // JMP $8003（停止用ループ）
            16'h8004: return 8'h03;
            16'h8005: return 8'h80;
            16'h0020: return 8'h01;
            16'h0021: return 8'h00;
            16'h0001: return 8'h01;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata         = 0;
            opcode_seen          = 0;
            instruction_finished = 0;
        } else {
            cpubus.rdata = memory(cpubus.addr);
            // logic_analizer[15]はCPUがDECODE状態に入ったことを表す。
            if (logic_analizer[15]) {
                if opcode_seen {
                    // 次の命令までデコードできれば、対象命令の実行は完了している。
                    instruction_finished = 1;
                } else if (logic_analizer[7:0] == test_opcode) {
                    opcode_seen = 1;
                }
            }
        }
    }

    initial {
        stall       = 0;
        nmi         = 0;
        halt        = 0;
        test_opcode = 0;

        for i in 0..$size(DECODE_TABLE) {
            test_opcode = DECODE_TABLE[i].opcode;
            rst.assert();
            clk.next(30);
            $assert(opcode_seen);
            $assert(instruction_finished);
            $display(
                "opcode %h %-3s execute: OK",
                test_opcode,
                instruction_name_for_execute(DECODE_TABLE[i].inst_kind),
            );
        }

        $display("CPU execution smoke: all %d opcodes passed", $size(DECODE_TABLE));
        $finish();
    }

    function instruction_name_for_execute (
        instruction: input inst_t,
    ) -> logic<24> {
        case (instruction) {
            inst_t::BRK: return "BRK";
            inst_t::RTI: return "RTI";
            inst_t::PHA: return "PHA";
            inst_t::PLA: return "PLA";
            inst_t::PHP: return "PHP";
            inst_t::PLP: return "PLP";
            inst_t::SEI: return "SEI";
            inst_t::SEC: return "SEC";
            inst_t::CLI: return "CLI";
            inst_t::CLD: return "CLD";
            inst_t::CLC: return "CLC";
            inst_t::SED: return "SED";
            inst_t::CLV: return "CLV";
            inst_t::NOP: return "NOP";
            inst_t::TXS: return "TXS";
            inst_t::TSX: return "TSX";
            inst_t::TAX: return "TAX";
            inst_t::TXA: return "TXA";
            inst_t::TAY: return "TAY";
            inst_t::TYA: return "TYA";
            inst_t::INX: return "INX";
            inst_t::INY: return "INY";
            inst_t::INC: return "INC";
            inst_t::DEC: return "DEC";
            inst_t::ASL: return "ASL";
            inst_t::LSR: return "LSR";
            inst_t::ROL: return "ROL";
            inst_t::ROR: return "ROR";
            inst_t::DEX: return "DEX";
            inst_t::DEY: return "DEY";
            inst_t::LDA: return "LDA";
            inst_t::LDX: return "LDX";
            inst_t::LDY: return "LDY";
            inst_t::CPX: return "CPX";
            inst_t::CPY: return "CPY";
            inst_t::CMP: return "CMP";
            inst_t::ADC: return "ADC";
            inst_t::SBC: return "SBC";
            inst_t::ORA: return "ORA";
            inst_t::AND: return "AND";
            inst_t::EOR: return "EOR";
            inst_t::STA: return "STA";
            inst_t::STX: return "STX";
            inst_t::STY: return "STY";
            inst_t::BIT: return "BIT";
            inst_t::BCC: return "BCC";
            inst_t::BCS: return "BCS";
            inst_t::BNE: return "BNE";
            inst_t::BEQ: return "BEQ";
            inst_t::BPL: return "BPL";
            inst_t::BMI: return "BMI";
            inst_t::BVC: return "BVC";
            inst_t::BVS: return "BVS";
            inst_t::JMP: return "JMP";
            inst_t::JSR: return "JSR";
            inst_t::RTS: return "RTS";
            default    : return "???";
        }
    }
}

/// ロード、ストア、レジスタ転送命令を実際にCPUで実行する。
///
/// 最後のJMPで停止用ループへ入り、その時点のレジスタと
/// ゼロページへの書き込み結果を確認する。
#[test(test_cpu_load_store_transfer_execution)]
module test_cpu_load_store_transfer_execution {
    import cpu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var mem_10        : logic<8> ;
    var mem_11        : logic<8> ;
    var mem_12        : logic<8> ;

    inst cpubus: bus_if::<8, 16>;

    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;

            16'h8000: return 8'hA9; // LDA #$42
            16'h8001: return 8'h42;
            16'h8002: return 8'h85; // STA $10
            16'h8003: return 8'h10;
            16'h8004: return 8'hA2; // LDX #$80
            16'h8005: return 8'h80;
            16'h8006: return 8'h86; // STX $11
            16'h8007: return 8'h11;
            16'h8008: return 8'hA0; // LDY #$00
            16'h8009: return 8'h00;
            16'h800A: return 8'h84; // STY $12
            16'h800B: return 8'h12;

            16'h800C: return 8'hAA; // TAX: A($42) -> X
            16'h800D: return 8'h8A; // TXA: X($42) -> A
            16'h800E: return 8'hA8; // TAY: A($42) -> Y
            16'h800F: return 8'h98; // TYA: Y($42) -> A
            16'h8010: return 8'hBA; // TSX: SP($FD) -> X
            16'h8011: return 8'h9A; // TXS: X($FD) -> SP（フラグは変えない）

            16'h8012: return 8'h4C; // JMP $8012
            16'h8013: return 8'h12;
            16'h8014: return 8'h80;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            mem_10       = 0;
            mem_11       = 0;
            mem_12       = 0;
        } else {
            case (cpubus.addr) {
                16'h0010: cpubus.rdata = mem_10;
                16'h0011: cpubus.rdata = mem_11;
                16'h0012: cpubus.rdata = mem_12;
                default : cpubus.rdata = rom(cpubus.addr);
            }

            if cpubus.wen {
                case (cpubus.addr) {
                    16'h0010: mem_10 = cpubus.wdata;
                    16'h0011: mem_11 = cpubus.wdata;
                    16'h0012: mem_12 = cpubus.wdata;
                    default : {}
                }
            }
        }
    }

    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();

        clk.next(100);

        $assert(mem_10 == 8'h42);
        $display("LDA/STA: A=%h [$10]=%h OK", dut.reg_a, mem_10);

        $assert(mem_11 == 8'h80);
        $display("LDX/STX: [$11]=%h OK", mem_11);

        $assert(mem_12 == 8'h00);
        $display("LDY/STY: [$12]=%h OK", mem_12);

        $assert(dut.reg_a == 8'h42);
        $assert(dut.reg_y == 8'h42);
        $display("TAX/TXA/TAY/TYA: A=%h Y=%h OK", dut.reg_a, dut.reg_y);

        $assert(dut.reg_x == 8'hFD);
        $assert(dut.reg_sp == 8'hFD);
        $assert(dut.reg_p[FLAG_NEGATIVE]);
        $display("TSX/TXS: X=%h SP=%h N=%b OK", dut.reg_x, dut.reg_sp, dut.reg_p[FLAG_NEGATIVE]);

        $assert(debug_pc == 16'h8012);
        $display("JMP: PC=%h OK", debug_pc);
        $finish();
    }
}

/// LDA/LDX/LDYの全18オペコードについて、ロード結果とZ/Nを確認する。
#[test(test_all_load_opcode_results)]
module test_all_load_opcode_results {
    import cpu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic          ;
    var nmi           : logic          ;
    var halt          : logic          ;
    var debug_pc      : logic      <16>;
    var logic_analizer: logic      <16>;
    var test_opcode   : logic      <8> ;
    var test_mode     : addr_mode_t    ;
    var checks        : logic      <5> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function is_load (
        instruction: input inst_t,
    ) -> logic {
        return instruction == inst_t::LDA || instruction == inst_t::LDX || instruction == inst_t::LDY;
    }

    function expected_value (
        mode: input addr_mode_t,
    ) -> logic<8> {
        if mode == addr_mode_t::IMM {
            return 8'h20;
        } else {
            return 8'h81;
        }
    }

    function memory (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return test_opcode;
            16'h8001: return 8'h20;
            16'h8002: return 8'h00;
            16'h8003: return 8'h4C;
            16'h8004: return 8'h03;
            16'h8005: return 8'h80;
            16'h0020: {
                // 間接モードでは$20/$21を、検査値がある$0030へのポインタにする。
                if test_mode == addr_mode_t::INDX || test_mode == addr_mode_t::INDY {
                    return 8'h30;
                } else {
                    return 8'h81;
                }
            }
            16'h0021: return 8'h00;
            16'h0030: return 8'h81;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
        } else {
            cpubus.rdata = memory(cpubus.addr);
        }
    }

    initial {
        stall       = 0;
        nmi         = 0;
        halt        = 0;
        test_opcode = 0;
        test_mode   = addr_mode_t::IMPLIED;
        checks      = 0;

        for i in 0..$size(DECODE_TABLE) {
            if is_load(DECODE_TABLE[i].inst_kind) {
                test_opcode = DECODE_TABLE[i].opcode;
                test_mode   = DECODE_TABLE[i].mode;
                rst.assert();
                clk.next(20);

                case (DECODE_TABLE[i].inst_kind) {
                    inst_t::LDA: $assert(dut.reg_a == expected_value(test_mode));
                    inst_t::LDX: $assert(dut.reg_x == expected_value(test_mode));
                    inst_t::LDY: $assert(dut.reg_y == expected_value(test_mode));
                    default    : $assert(0);
                }
                $assert(!dut.reg_p[FLAG_ZERO]);
                $assert(dut.reg_p[FLAG_NEGATIVE] == (test_mode != addr_mode_t::IMM));
                checks = checks + 1;
                $display(
                    "opcode %h load result=%h Z=0 N=%b OK",
                    test_opcode,
                    expected_value(test_mode),
                    dut.reg_p[FLAG_NEGATIVE],
                );
            }
        }

        $assert(checks == 18);
        $display("Load execution results: all %d opcodes passed", checks);
        $finish();
    }
}

/// 算術・論理・比較命令を実行し、演算結果とフラグを確認する。
#[test(test_cpu_alu_compare_execution)]
module test_cpu_alu_compare_execution {
    import cpu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var result_10     : logic<8> ;
    var result_11     : logic<8> ;
    var result_12     : logic<8> ;
    var result_13     : logic<8> ;
    var result_14     : logic<8> ;

    inst cpubus: bus_if::<8, 16>;

    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;

            16'h8000: return 8'h18; // CLC
            16'h8001: return 8'hA9; // LDA #$7F
            16'h8002: return 8'h7F;
            16'h8003: return 8'h69; // ADC #$01 -> $80
            16'h8004: return 8'h01;
            16'h8005: return 8'h85; // STA $10
            16'h8006: return 8'h10;

            16'h8007: return 8'h38; // SEC
            16'h8008: return 8'hA9; // LDA #$80
            16'h8009: return 8'h80;
            16'h800A: return 8'hE9; // SBC #$01 -> $7F
            16'h800B: return 8'h01;
            16'h800C: return 8'h85; // STA $11
            16'h800D: return 8'h11;

            16'h800E: return 8'hA9; // LDA #$F0
            16'h800F: return 8'hF0;
            16'h8010: return 8'h29; // AND #$0F -> $00
            16'h8011: return 8'h0F;
            16'h8012: return 8'h85; // STA $12
            16'h8013: return 8'h12;
            16'h8014: return 8'h09; // ORA #$80 -> $80
            16'h8015: return 8'h80;
            16'h8016: return 8'h85; // STA $13
            16'h8017: return 8'h13;
            16'h8018: return 8'h49; // EOR #$FF -> $7F
            16'h8019: return 8'hFF;
            16'h801A: return 8'h85; // STA $14
            16'h801B: return 8'h14;

            16'h801C: return 8'hA9; // LDA #$40
            16'h801D: return 8'h40;
            16'h801E: return 8'hC9; // CMP #$40: C=1, Z=1
            16'h801F: return 8'h40;
            16'h8020: return 8'hA2; // LDX #$10
            16'h8021: return 8'h10;
            16'h8022: return 8'hE0; // CPX #$20: C=0, N=1
            16'h8023: return 8'h20;
            16'h8024: return 8'hA0; // LDY #$80
            16'h8025: return 8'h80;
            16'h8026: return 8'hC0; // CPY #$7F: C=1, N=0
            16'h8027: return 8'h7F;

            16'h8028: return 8'hA9; // LDA #$0F
            16'h8029: return 8'h0F;
            16'h802A: return 8'h24; // BIT $30 ($C0): Z=1, V=1, N=1
            16'h802B: return 8'h30;

            16'h802C: return 8'h4C; // JMP $802C
            16'h802D: return 8'h2C;
            16'h802E: return 8'h80;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            result_10    = 0;
            result_11    = 0;
            result_12    = 0;
            result_13    = 0;
            result_14    = 0;
        } else {
            case (cpubus.addr) {
                16'h0010: cpubus.rdata = result_10;
                16'h0011: cpubus.rdata = result_11;
                16'h0012: cpubus.rdata = result_12;
                16'h0013: cpubus.rdata = result_13;
                16'h0014: cpubus.rdata = result_14;
                16'h0030: cpubus.rdata = 8'hC0;
                default : cpubus.rdata = rom(cpubus.addr);
            }

            if cpubus.wen {
                case (cpubus.addr) {
                    16'h0010: result_10 = cpubus.wdata;
                    16'h0011: result_11 = cpubus.wdata;
                    16'h0012: result_12 = cpubus.wdata;
                    16'h0013: result_13 = cpubus.wdata;
                    16'h0014: result_14 = cpubus.wdata;
                    default : {}
                }
            }
        }
    }

    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();

        clk.next(180);

        $assert(result_10 == 8'h80);
        $display("ADC: $7F + $01 = %h OK", result_10);
        $assert(result_11 == 8'h7F);
        $display("SBC: $80 - $01 = %h OK", result_11);
        $assert(result_12 == 8'h00);
        $display("AND: $F0 & $0F = %h OK", result_12);
        $assert(result_13 == 8'h80);
        $display("ORA: $00 | $80 = %h OK", result_13);
        $assert(result_14 == 8'h7F);
        $display("EOR: $80 ^ $FF = %h OK", result_14);

        // 最後のBITはCを変更しないため、CPYで立ったCも同時に確認できる。
        $assert(dut.reg_p[FLAG_CARRY]);
        $assert(dut.reg_p[FLAG_ZERO]);
        $assert(dut.reg_p[FLAG_OVERFLOW]);
        $assert(dut.reg_p[FLAG_NEGATIVE]);
        $display("CMP/CPX/CPY/BIT: C=%b Z=%b V=%b N=%b OK", dut.reg_p[0], dut.reg_p[1], dut.reg_p[6], dut.reg_p[7]);

        $assert(debug_pc == 16'h802C);
        $finish();
    }
}

/// ALU・比較命令の全56オペコードを実行し、結果レジスタとC/Z/Nを確認する。
#[test(test_all_alu_compare_opcode_results)]
module test_all_alu_compare_opcode_results {
    import cpu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic          ;
    var nmi           : logic          ;
    var halt          : logic          ;
    var debug_pc      : logic      <16>;
    var logic_analizer: logic      <16>;
    var test_opcode   : logic      <8> ;
    var test_mode     : addr_mode_t    ;
    var checks        : logic      <6> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function is_alu_or_compare (
        instruction: input inst_t,
    ) -> logic {
        return instruction == inst_t::ADC || instruction == inst_t::SBC || instruction == inst_t::ORA || instruction
            == inst_t::AND || instruction == inst_t::EOR || instruction == inst_t::CMP || instruction == inst_t::CPX
            || instruction == inst_t::CPY || instruction == inst_t::BIT;
    }

    function operand_value (
        mode: input addr_mode_t,
    ) -> logic<8> {
        if mode == addr_mode_t::IMM {
            return 8'h20;
        } else {
            return 8'h01;
        }
    }

    function expected_a (
        instruction: input inst_t   ,
        operand    : input logic <8>,
    ) -> logic<8> {
        case (instruction) {
            inst_t::ADC: return operand; // A=0, C=0
            inst_t::SBC: return ~operand; // A=0, C=0なので0-operand-1
            inst_t::ORA: return operand;
            inst_t::AND: return 0;
            inst_t::EOR: return operand;
            default    : return 0; // 比較命令とBITはAを変更しない
        }
    }

    function changes_a (
        instruction: input inst_t,
    ) -> logic {
        return instruction == inst_t::ADC || instruction == inst_t::SBC || instruction == inst_t::ORA || instruction
            == inst_t::AND || instruction == inst_t::EOR;
    }

    function memory (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return test_opcode;
            16'h8001: return 8'h20;
            16'h8002: return 8'h00;
            16'h8003: return 8'h4C;
            16'h8004: return 8'h03;
            16'h8005: return 8'h80;
            16'h0020: {
                if test_mode == addr_mode_t::INDX || test_mode == addr_mode_t::INDY {
                    return 8'h30;
                } else {
                    return 8'h01;
                }
            }
            16'h0021: return 8'h00;
            16'h0030: return 8'h01;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
        } else {
            cpubus.rdata = memory(cpubus.addr);
        }
    }

    initial {
        stall       = 0;
        nmi         = 0;
        halt        = 0;
        test_opcode = 0;
        test_mode   = addr_mode_t::IMPLIED;
        checks      = 0;

        for i in 0..$size(DECODE_TABLE) {
            if is_alu_or_compare(DECODE_TABLE[i].inst_kind) {
                let instruction: inst_t = DECODE_TABLE[i].inst_kind;
                test_opcode = DECODE_TABLE[i].opcode;
                test_mode   = DECODE_TABLE[i].mode;
                rst.assert();
                clk.next(20);

                if changes_a(instruction) {
                    $assert(dut.reg_a == expected_a(instruction, operand_value(test_mode)));
                } else {
                    $assert(dut.reg_a == 0);
                }

                case (instruction) {
                    inst_t::AND: {
                        $assert(!dut.reg_p[FLAG_CARRY]);
                        $assert(dut.reg_p[FLAG_ZERO]);
                        $assert(!dut.reg_p[FLAG_NEGATIVE]);
                    }
                    inst_t::SBC, inst_t::CMP, inst_t::CPX, inst_t::CPY: {
                        $assert(!dut.reg_p[FLAG_CARRY]);
                        $assert(!dut.reg_p[FLAG_ZERO]);
                        $assert(dut.reg_p[FLAG_NEGATIVE]);
                    }
                    inst_t::BIT: {
                        $assert(!dut.reg_p[FLAG_CARRY]);
                        $assert(dut.reg_p[FLAG_ZERO]);
                        $assert(!dut.reg_p[FLAG_NEGATIVE]);
                    }
                    default: {
                        $assert(!dut.reg_p[FLAG_CARRY]);
                        $assert(!dut.reg_p[FLAG_ZERO]);
                        $assert(!dut.reg_p[FLAG_NEGATIVE]);
                    }
                }

                checks = checks + 1;
                $display(
                    "opcode %h ALU A=%h C=%b Z=%b N=%b OK",
                    test_opcode,
                    dut.reg_a,
                    dut.reg_p[FLAG_CARRY],
                    dut.reg_p[FLAG_ZERO],
                    dut.reg_p[FLAG_NEGATIVE],
                );
            }
        }

        $assert(checks == 56);
        $display("ALU/compare execution results: all %d opcodes passed", checks);
        $finish();
    }
}

#[test(test_cpu_flag_and_nop_execution)]
module test_cpu_flag_and_nop_execution {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var check_count   : logic<4> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    function rom (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'h38; // SEC
            16'h8001: return 8'h08; // PHP
            16'h8002: return 8'h18; // CLC
            16'h8003: return 8'h08;
            16'h8004: return 8'h78; // SEI
            16'h8005: return 8'h08;
            16'h8006: return 8'h58; // CLI
            16'h8007: return 8'h08;
            16'h8008: return 8'hF8; // SED
            16'h8009: return 8'h08;
            16'h800A: return 8'hD8; // CLD
            16'h800B: return 8'h08;
            16'h800C: return 8'hA9; // Make V=1 with $40 + $40.
            16'h800D: return 8'h40;
            16'h800E: return 8'h69;
            16'h800F: return 8'h40;
            16'h8010: return 8'hB8; // CLV
            16'h8011: return 8'h08;
            16'h8012: return 8'hEA; // NOP
            16'h8013: return 8'h4C; // Stop in a visible loop.
            16'h8014: return 8'h13;
            16'h8015: return 8'h80;
            default : return 0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            check_count  = 0;
        } else {
            cpubus.rdata = rom(cpubus.addr);
            if (cpubus.wen) {
                case (cpubus.addr) {
                    16'h01FD: $assert(cpubus.wdata == 8'h35); // SEC
                    16'h01FC: $assert(cpubus.wdata == 8'h34); // CLC
                    16'h01FB: $assert(cpubus.wdata == 8'h34); // SEI
                    16'h01FA: $assert(cpubus.wdata == 8'h30); // CLI
                    16'h01F9: $assert(cpubus.wdata == 8'h38); // SED
                    16'h01F8: $assert(cpubus.wdata == 8'h30); // CLD
                    16'h01F7: $assert(cpubus.wdata == 8'hB0); // CLV
                    default : {}
                }
                if (cpubus.addr >= 16'h01F7 && cpubus.addr <= 16'h01FD) {
                    check_count = check_count + 1;
                }
            }
        }
    }

    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(150);
        $assert(check_count == 7);
        $assert(debug_pc == 16'h8013);
        $display("SEC/CLC: carry set and cleared OK");
        $display("SEI/CLI: interrupt disable set and cleared OK");
        $display("SED/CLD: decimal mode set and cleared OK");
        $display("CLV: overflow cleared, other flags preserved OK");
        $display("NOP: execution continued to PC=8013 OK");
        $finish();
    }
}
