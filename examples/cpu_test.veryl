#[test(test_cpu_program_execution)]
module test_cpu_program_execution {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var write_10_seen : logic    ;
    var write_10_data : logic<8> ;
    var write_11_seen : logic    ;
    var write_11_data : logic<8> ;
    var trace_cycle   : logic<8> ;

    inst cpubus: bus_if::<8, 16>;

    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );

    // Reset vector $8000, followed by a short program covering immediate
    // arithmetic, zero-page stores, register operations, compare and branch.
    function program_data (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: { return 8'h00; }
            16'hFFFD: { return 8'h80; }
            16'h8000: { return 8'hA9; } // LDA #$05
            16'h8001: { return 8'h05; }
            16'h8002: { return 8'h69; } // ADC #$03
            16'h8003: { return 8'h03; }
            16'h8004: { return 8'h85; } // STA $10
            16'h8005: { return 8'h10; }
            16'h8006: { return 8'hA2; } // LDX #$02
            16'h8007: { return 8'h02; }
            16'h8008: { return 8'hE8; } // INX
            16'h8009: { return 8'hE0; } // CPX #$03
            16'h800A: { return 8'h03; }
            16'h800B: { return 8'hD0; } // BNE +2 (not taken)
            16'h800C: { return 8'h02; }
            16'h800D: { return 8'hA0; } // LDY #$7F
            16'h800E: { return 8'h7F; }
            16'h800F: { return 8'h84; } // STY $11
            16'h8010: { return 8'h11; }
            16'h8011: { return 8'h4C; } // JMP $8011
            16'h8012: { return 8'h11; }
            16'h8013: { return 8'h80; }
            default  : { return 0; }
        }
    }

    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            write_10_seen = 0;
            write_10_data = 0;
            write_11_seen = 0;
            write_11_data = 0;
            trace_cycle = 0;
        } else {
            trace_cycle = trace_cycle + 1;
            cpubus.rdata = program_data(cpubus.addr);
            if (stall) {
                $display(
                    "CPU cycle=%d STALL pc=%h",
                    trace_cycle,
                    debug_pc,
                );
            } else if (cpubus.wen) {
                $display(
                    "CPU cycle=%d WRITE pc=%h addr=%h data=%h",
                    trace_cycle,
                    debug_pc,
                    cpubus.addr,
                    cpubus.wdata,
                );
            } else {
                $display(
                    "CPU cycle=%d READ  pc=%h addr=%h data=%h",
                    trace_cycle,
                    debug_pc,
                    cpubus.addr,
                    cpubus.rdata,
                );
            }
            if (logic_analizer[15]) {
                $display(
                    "CPU instruction: pc=%h opcode=%h",
                    debug_pc,
                    logic_analizer[7:0],
                );
            }
            if (cpubus.wen && cpubus.addr == 16'h0010) {
                write_10_seen = 1;
                write_10_data = cpubus.wdata;
            }
            if (cpubus.wen && cpubus.addr == 16'h0011) {
                write_11_seen = 1;
                write_11_data = cpubus.wdata;
            }
        }
    }

    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;

        rst.assert();

        // A stalled CPU must hold the reset state and program counter.
        stall = 1;
        clk.next(4);
        $assert(debug_pc == 0);
        stall = 0;

        clk.next(80);
        $display(
            "CPU result: pc=%h a=%h x=%h y=%h p=%h mem10=%h mem11=%h",
            debug_pc,
            dut.reg_a,
            dut.reg_x,
            dut.reg_y,
            dut.reg_p,
            write_10_data,
            write_11_data,
        );
        $assert(dut.reg_a == 8'h08);
        $assert(dut.reg_x == 8'h03);
        $assert(dut.reg_y == 8'h7F);
        $assert(dut.reg_p[0]);
        $assert(write_10_seen && write_10_data == 8'h08);
        $assert(write_11_seen && write_11_data == 8'h7F);
        $assert(debug_pc == 16'h8011);

        $finish();
    }
}
