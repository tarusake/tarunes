#[test(test_cpu_bit_flags)]
module test_cpu_bit_flags {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var stall         : logic    ;
    var nmi           : logic    ;
    var halt          : logic    ;
    var debug_pc      : logic<16>;
    var logic_analizer: logic<16>;
    var checks        : logic<2> ;
    inst cpubus: bus_if::<8, 16>;
    inst dut: cpu (
        clk           : clk           ,
        rst           : rst           ,
        stall         : stall         ,
        nmi           : nmi           ,
        halt          : halt          ,
        debug_pc      : debug_pc      ,
        logic_analizer: logic_analizer,
        cpubus        : cpubus        ,
    );
    function mem_data (
        addr: input logic<16>,
    ) -> logic<8> {
        case (addr) {
            16'hFFFC: return 8'h00;
            16'hFFFD: return 8'h80;
            16'h8000: return 8'hA9;
            16'h8001: return 8'h0F;
            16'h8002: return 8'h24;
            16'h8003: return 8'h20;
            16'h8004: return 8'h08;
            16'h8005: return 8'hA9;
            16'h8006: return 8'h40;
            16'h8007: return 8'h2C;
            16'h8008: return 8'h34;
            16'h8009: return 8'h12;
            16'h800A: return 8'h08;
            16'h800B: return 8'hA9;
            16'h800C: return 8'h80;
            16'h800D: return 8'h24;
            16'h800E: return 8'h21;
            16'h800F: return 8'h08;
            16'h8010: return 8'h4C;
            16'h8011: return 8'h10;
            16'h8012: return 8'h80;
            16'h0020: return 8'hC0;
            16'h1234: return 8'h40;
            16'h0021: return 8'h80;
            default : return 0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cpubus.rdata = 0;
            checks       = 0;
        } else {
            cpubus.rdata = mem_data(cpubus.addr);
            if (cpubus.wen) {
                case (cpubus.addr) {
                    16'h01FD: {
                        $assert(cpubus.wdata == 8'hF6);
                        checks = checks + 1;
                    }
                    16'h01FC: {
                        $assert(cpubus.wdata == 8'h74);
                        checks = checks + 1;
                    }
                    16'h01FB: {
                        $assert(cpubus.wdata == 8'hB4);
                        checks = checks + 1;
                    }
                    default: {}
                }
                $display("BIT flags: stack=%h p=%h", cpubus.addr, cpubus.wdata);
            }
        }
    }
    initial {
        stall = 0;
        nmi   = 0;
        halt  = 0;
        rst.assert();
        clk.next(120);
        $display("BIT summary: pc=%h checks=%d a=%h", debug_pc, checks, dut.reg_a);
        $assert(checks == 3);
        $assert(dut.reg_a == 8'h80);
        $assert(debug_pc == 16'h8010);
        $finish();
    }
}
