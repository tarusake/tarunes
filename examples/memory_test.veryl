#[test(test_memory_read_write)]
module test_memory_read_write {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stall: logic;

    inst membus: bus_if::<8, 4>;

    inst dut: memory::<8, 4> (
        clk   : clk   ,
        rst   : rst   ,
        stall : stall ,
        membus: membus,
    );

    initial {
        stall        = 0;
        membus.addr  = 0;
        membus.wen   = 0;
        membus.wdata = 0;

        rst.assert();
        $assert(membus.rdata == 0);

        membus.addr  = 4'h3;
        membus.wen   = 1;
        membus.wdata = 8'hA5;
        clk.next();

        membus.wen = 0;
        clk.next();
        $display("Memory read: addr=%h data=%h", membus.addr, membus.rdata);
        $assert(membus.rdata == 8'hA5);

        // Neither writes nor the registered read output advance while stalled.
        stall        = 1;
        membus.addr  = 4'h4;
        membus.wen   = 1;
        membus.wdata = 8'h5A;
        clk.next();
        $display("Memory stalled: held_data=%h", membus.rdata);
        $assert(membus.rdata == 8'hA5);

        stall       = 0;
        membus.wen  = 0;
        membus.addr = 4'h4;
        clk.next();
        $display("Memory ignored stalled write: addr=%h data=%h", membus.addr, membus.rdata);
        $assert(membus.rdata == 0);

        $finish();
    }
}
