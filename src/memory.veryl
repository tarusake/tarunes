/// パラメータ化された同期読み出し・書き込みメモリ。
/// `PATH`が指定されている場合は`$readmemh`で初期化する。`stall`中は読み書きを止める。
pub module memory::<DATA_WIDTH: u32, ADDR_WIDTH: u32> #(
    param PATH: string = "",
) (
    clk   : input   clock                                  ,
    rst   : input   reset                                  ,
    stall : input   logic                                  ,
    membus: modport bus_if::<DATA_WIDTH, ADDR_WIDTH>::slave,
) {
    #[allow(initial_assign)]
    var mem: logic<DATA_WIDTH> [2 ** ADDR_WIDTH];

    initial {
        if PATH != "" {
            $readmemh(PATH, mem);
        }
    }

    always_ff {
        if_reset {
            membus.rdata = 0;
        } else if !stall {
            membus.rdata = mem[membus.addr];
            if membus.wen {
                mem[membus.addr] = membus.wdata;
            }
        }
    }
}
