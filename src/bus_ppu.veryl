/// パターンテーブルとネームテーブルを接続するPPUメモリデコーダ。
///
/// `$0000-$1FFF`でCHR ROM、`$2000-$3EFF`でネーム／属性メモリを選択する。
/// CPUインターコネクトと同様、読み出し先をレジスタに保存するため、
/// アドレスをサンプリングした次のサイクルに読み出しデータを返す。
/// パレットRAM（`$3F00-$3FFF`）は`ppu`内部にあり、このバスを経由しない。
///
/// ```wavedrom
/// {signal: [
///   {name: 'clk',          wave: 'p....'},
///   {name: 'ppubus.addr',  wave: 'x=..x', data: ['$23C0']},
///   {name: 'ppubus.wen',   wave: '0....'},
///   {name: 'sel_vram',     wave: '01.0.'},
///   {name: 'sel_vram_d',   wave: '0.1.0'},
///   {name: 'ppubus.rdata', wave: 'x.=.x', data: ['属性バイト']}
/// ], head: {text: 'PPU読出：アドレスフェーズと応答フェーズ'}}
/// ```
pub module bus_ppu (
    clk    : input   clock                  ,
    rst    : input   reset                  ,
    stall  : input   logic                  ,
    ppubus : modport bus_if::<8, 14>::slave ,
    crombus: modport bus_if::<8, 13>::master,
    vrambus: modport bus_if::<8, 11>::master,
) {

    var sel_crom: logic;
    var sel_vram: logic;

    // Addr sel
    assign sel_crom = ppubus.addr <: 16'h2000;
    assign sel_vram = ppubus.addr >= 16'h2000 && ppubus.addr <: 16'h3F00;

    // address assign
    assign crombus.addr = if sel_crom ? ppubus.addr : 0;
    assign vrambus.addr = if sel_vram ? ppubus.addr : 0;

    // Write bus assign
    assign vrambus.wdata = if sel_vram ? ppubus.wdata : 0;
    assign vrambus.wen   = if sel_vram ? ppubus.wen : 0;

    // rom
    assign crombus.wdata = 0;
    assign crombus.wen   = 0;

    // Read bus decode
    var sel_crom_d: logic;
    var sel_vram_d: logic;

    always_ff {
        if_reset {
            sel_crom_d = 0;
            sel_vram_d = 0;
        } else if !stall {
            sel_crom_d = sel_crom;
            sel_vram_d = sel_vram;
        }
    }

    always_comb {
        if (sel_crom_d) {
            ppubus.rdata = crombus.rdata;
        } else if (sel_vram_d) {
            ppubus.rdata = vrambus.rdata;
        } else {
            ppubus.rdata = 0;
        }
    }

}
