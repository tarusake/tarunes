/// CPU・PPUと周辺回路で共有するアドレス／データバス。
/// `ren=1`なら読み出し、`wen=1`なら書き込み、どちらも0ならアクセスしない。
pub interface bus_if::<DATA_WIDTH: u32, ADDR_WIDTH: u32> {
    var addr : logic<ADDR_WIDTH>;
    var ren  : logic            ;
    var wen  : logic            ;
    var wdata: logic<DATA_WIDTH>;
    var rdata: logic<DATA_WIDTH>;

    modport master {
        addr : output,
        ren  : output,
        wen  : output,
        wdata: output,
        rdata: input ,
    }

    modport slave {
        ..converse(master)
    }

}
