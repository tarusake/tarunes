module cpu (
    clk           : input   clock                      ,
    rst           : input   reset                      ,
    stall         : input   logic                      ,
    nmi           : input   logic                      ,
    halt          : input   logic                      ,
    debug_pc      : output  logic                  <16>,
    logic_analizer: output  logic                  <16>,
    cpubus        : modport bus_if::<8, 16>::master    ,
) {
    // CPU Registers
    var reg_a : logic<8> ; // Accumulator
    var reg_x : logic<8> ; // X register
    var reg_y : logic<8> ; // Y register
    var reg_sp: logic<8> ; // Stack pointer
    var reg_pc: logic<16>; // Program counter
    var reg_p : logic<8> ; // Status Register

    var op1             : logic<8> ;
    var op2             : logic<8> ;
    var ptr_addr        : logic<8> ;
    var eff_addr        : logic<16>;
    var return_addr     : logic<16>;
    var interrupt_vector: logic<16>;
    var interrupt_status: logic<8> ;
    var inst_len        : logic<16>;
    var nmi_d           : logic    ;
    var nmi_pending     : logic    ;

    enum inst_t {
        INVALID,
        BRK,
        RTI,
        PHA,
        PLA,
        PHP,
        PLP,
        SEI,
        SEC,
        CLI,
        CLD,
        CLC,
        SED,
        CLV,
        NOP,
        TXS,
        TSX,
        TAX,
        TXA,
        TAY,
        TYA,
        INX,
        INY,
        INC,
        DEC,
        ASL,
        LSR,
        ROL,
        ROR,
        DEX,
        DEY,
        LDA,
        LDX,
        LDY,
        CPX,
        CPY,
        CMP,
        ADC,
        SBC,
        ORA,
        AND,
        EOR,
        STA,
        STX,
        STY,
        BIT,
        BCC,
        BCS,
        BNE,
        BEQ,
        BPL,
        BMI,
        BVC,
        BVS,
        JMP,
        JSR,
        RTS,
    }
    var decoded_inst: inst_t;

    enum addr_mode_t {
        IMPLIED,
        IMM,
        ZP,
        ZPX,
        ZPY,
        ABS,
        ABSX,
        ABSY,
        IND,
        INDX,
        INDY,
        REL,
    }
    var addr_mode: addr_mode_t;

    struct decode_entry_t {
        opcode   : logic      <8> ,
        inst_kind: inst_t         ,
        mode     : addr_mode_t    ,
        len      : logic      <16>,
    }
    const DECODE_TABLE: decode_entry_t [151] = '{
        decode_entry_t'{opcode: 8'h00, inst_kind: inst_t::BRK, mode: addr_mode_t::IMPLIED, len: 2,},
        decode_entry_t'{opcode: 8'h40, inst_kind: inst_t::RTI, mode: addr_mode_t::IMPLIED, len: 1,},
        decode_entry_t'{opcode: 8'h48, inst_kind: inst_t::PHA, mode: addr_mode_t::IMPLIED, len: 1,},
