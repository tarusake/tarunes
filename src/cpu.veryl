/// Ricoh 2A03互換の6502 CPUコア。
///
/// ## 命令デコード
///
/// `DECODE`で読み込んだオペコードを`cpu_pkg::DECODE_TABLE`から検索する。
/// デコード結果には命令種別、アドレッシングモード、命令長が含まれる。
/// 未対応のオペコードは`INVALID`となり、アーキテクチャ状態を変更せず
/// `FETCH`へ戻る。
///
/// ```mermaid
/// flowchart LR
///     F[FETCH<br/>PCをバスへ出力] --> D[DECODE<br/>オペコードを検索]
///     D -->|インプライド| E[EXEC]
///     D -->|8ビットオペランド| O1[OP1]
///     D -->|16ビットオペランド| O1 --> O2[OP2]
///     O1 -->|ゼロページ / 相対 / 即値| E
///     O2 -->|絶対 / インデックス| E
///     O1 -->|インデックス間接| O2 --> O3[OP3] --> E
///     E -->|次の命令| F
///     E -->|読み出し・変更・書き戻し| RMW[RMW_WRITE] --> F
/// ```
///
/// アドレス生成と命令実行は分離されている。オペランド処理ステートで
/// `eff_addr`を構築し、`EXEC`でALU演算、レジスタ操作、分岐、ロード、
/// ストアを実行する。NMIパルスは`nmi_pending`にラッチし、命令境界に
/// 到達するまで保持する。
pub module cpu (
    clk           : input   clock                      ,
    rst           : input   reset                      ,
    stall         : input   logic                      ,
    nmi           : input   logic                      ,
    halt          : input   logic                      ,
    debug_pc      : output  logic                  <16>,
    logic_analizer: output  logic                  <16>,
    cpubus        : modport bus_if::<8, 16>::master    ,
) {
    import cpu_pkg::*;
    import nes_pkg::*;

    // CPU Registers
    var reg_a : logic<8> ; // Accumulator
    var reg_x : logic<8> ; // X register
    var reg_y : logic<8> ; // Y register
    var reg_sp: logic<8> ; // Stack pointer
    var reg_pc: logic<16>; // Program counter
    var reg_p : logic<8> ; // Status Register

    var op1             : logic      <8> ;
    var op2             : logic      <8> ;
    var ptr_addr        : logic      <8> ;
    var eff_addr        : logic      <16>;
    var return_addr     : logic      <16>;
    var interrupt_vector: logic      <16>;
    var interrupt_status: logic      <8> ;
    var inst_len        : logic      <16>;
    var nmi_d           : logic          ;
    var nmi_pending     : logic          ;
    var decoded_inst    : inst_t         ;
    var addr_mode       : addr_mode_t    ;

    enum cpu_state_t {
        RESET0,
        RESET1,
        RESET2,
        FETCH,
        DECODE,
        OP1,
        OP2,
        OP3,
        JMP_IND_LO,
        JMP_IND_HI,
        EXEC,
        RMW_WRITE,
        INT_PUSH_LO,
        INT_PUSH_P,
        INT_VECTOR_LO,
        INT_VECTOR_LO_WAIT,
        INT_VECTOR_HI,
        INT_VECTOR_HI_READ,
        JSR_PUSH_LO,
        RTI_PULL_P,
        RTI_WAIT_LO,
        RTI_PULL_HI,
        RTS_PULL_LO,
        RTS_WAIT_HI,
    }
    struct alu_result_t {
        value : logic<8>,
        status: logic<8>,
    }
    var state: cpu_state_t;

    function debug_cpu_state_str (
        debug_state: input cpu_state_t,
    ) -> logic<64> {
        case (debug_state) {
            cpu_state_t::RESET0            : return "RESET0";
            cpu_state_t::RESET1            : return "RESET1";
            cpu_state_t::RESET2            : return "RESET2";
            cpu_state_t::FETCH             : return "FETCH";
            cpu_state_t::DECODE            : return "DECODE";
            cpu_state_t::OP1               : return "OP1";
            cpu_state_t::OP2               : return "OP2";
            cpu_state_t::OP3               : return "OP3";
            cpu_state_t::JMP_IND_LO        : return "JMP_IL";
            cpu_state_t::JMP_IND_HI        : return "JMP_IH";
            cpu_state_t::EXEC              : return "EXEC";
            cpu_state_t::RMW_WRITE         : return "RMW_WR";
            cpu_state_t::INT_PUSH_LO       : return "INT_LO";
            cpu_state_t::INT_PUSH_P        : return "INT_P";
            cpu_state_t::INT_VECTOR_LO     : return "INT_VL";
            cpu_state_t::INT_VECTOR_LO_WAIT: return "INT_WL";
            cpu_state_t::INT_VECTOR_HI     : return "INT_VH";
            cpu_state_t::INT_VECTOR_HI_READ: return "INT_RH";
            cpu_state_t::JSR_PUSH_LO       : return "JSR_LO";
            cpu_state_t::RTI_PULL_P        : return "RTI_P";
            cpu_state_t::RTI_WAIT_LO       : return "RTI_WAIT";
            cpu_state_t::RTI_PULL_HI       : return "RTI_HI";
            cpu_state_t::RTS_PULL_LO       : return "RTS_LO";
            cpu_state_t::RTS_WAIT_HI       : return "RTS_WAIT";
            default                        : return "UNKNOWN";
        }
    }

    /// 演算結果に合わせてZ（ゼロ）とN（負数）フラグを更新する。
    function update_zn (
        status: input logic<8>,
        value : input logic<8>,
    ) -> logic<8> {
        var result               : logic<8>;
        result                = status;
        result[FLAG_ZERO]     = (value == 0);
        result[FLAG_NEGATIVE] = value[7];
        return result;
    }

    /// 算術・論理演算を実行し、結果値と更新後のフラグを返す。
    function alu_execute (
        instruction: input inst_t   ,
        left       : input logic <8>,
        right      : input logic <8>,
        status     : input logic <8>,
    ) -> alu_result_t {
        var result       : alu_result_t   ;
        var operand      : logic       <8>;
        var sum          : logic       <9>;
        result.value  = left;
        result.status = status;
        operand       = right;
        sum           = 0;

        case (instruction) {
            inst_t::ORA                          : result.value = left | right;
            inst_t::AND                          : result.value = left & right;
            inst_t::EOR                          : result.value = left ^ right;
            inst_t::INC, inst_t::INX, inst_t::INY: result.value = left + 1;
            inst_t::DEC, inst_t::DEX, inst_t::DEY: result.value = left - 1;
            inst_t::ASL                          : {
                result.value              = left << 1;
                result.status[FLAG_CARRY] = left[7];
            }
            inst_t::LSR: {
                result.value              = left >> 1;
                result.status[FLAG_CARRY] = left[0];
            }
            inst_t::ROL: {
                result.value              = {left[6:0], status[FLAG_CARRY]};
                result.status[FLAG_CARRY] = left[7];
            }
            inst_t::ROR: {
                result.value              = {status[FLAG_CARRY], left[7:1]};
                result.status[FLAG_CARRY] = left[0];
            }
            inst_t::ADC, inst_t::SBC: {
                if (instruction == inst_t::SBC) {
                    operand = ~right;
                }
                sum                          = {1'b0, left} + {1'b0, operand} + {8'h00, status[FLAG_CARRY]};
                result.value                 = sum[7:0];
                result.status[FLAG_CARRY]    = sum[8];
                result.status[FLAG_OVERFLOW] = ((left ^ result.value) & (operand ^ result.value) & 8'h80) != 0;
            }
            inst_t::CMP, inst_t::CPX, inst_t::CPY: {
                result.value              = left - right;
                result.status[FLAG_CARRY] = (left >= right);
            }
            inst_t::BIT: {
                result.status[FLAG_ZERO]     = ((left & right) == 0);
                result.status[FLAG_OVERFLOW] = right[6];
                result.status[FLAG_NEGATIVE] = right[7];
            }
        }

        case (instruction) {
            inst_t::BIT: {}
            default: {
                result.status[FLAG_ZERO]     = (result.value == 0);
                result.status[FLAG_NEGATIVE] = result.value[7];
            }
        }
        return result;
    }

    /// ゼロページ内で8ビット加算する。桁上がりは意図的に捨てる。
    function zero_page_addr (
        base : input logic<8>,
        index: input logic<8>,
    ) -> logic<16> {
        return {8'h00, base + index};
    }

    /// アドレッシングモードに応じてX/Yインデックスを加える。
    function indexed_addr (
        mode: input addr_mode_t    ,
        base: input logic      <16>,
        x   : input logic      <8> ,
        y   : input logic      <8> ,
    ) -> logic<16> {
        case (mode) {
            addr_mode_t::ZPX, addr_mode_t::ABSX                   : return base + x;
            addr_mode_t::ZPY, addr_mode_t::ABSY, addr_mode_t::INDY: return base + y;
            default                                               : return base;
        }
    }

    /// フラグ操作命令（SEI/CLIなど）をステータスレジスタへ反映する。
    function status_after_flag_inst (
        instruction: input inst_t   ,
        status     : input logic <8>,
    ) -> logic<8> {
        var result: logic<8>;
        result = status;
        case (instruction) {
            inst_t::SEI: result[FLAG_INTERRUPT] = 1;
            inst_t::CLI: result[FLAG_INTERRUPT] = 0;
            inst_t::SEC: result[FLAG_CARRY]     = 1;
            inst_t::CLC: result[FLAG_CARRY]     = 0;
            inst_t::SED: result[FLAG_DECIMAL]   = 1;
            inst_t::CLD: result[FLAG_DECIMAL]   = 0;
            inst_t::CLV: result[FLAG_OVERFLOW]  = 0;
        }
        return result;
    }

    /// 分岐命令が現在のフラグ条件を満たすか判定する。
    function branch_taken (
        instruction: input inst_t   ,
        status     : input logic <8>,
    ) -> logic {
        case (instruction) {
            inst_t::BCC: return !status[FLAG_CARRY];
            inst_t::BCS: return status[FLAG_CARRY];
            inst_t::BNE: return !status[FLAG_ZERO];
            inst_t::BEQ: return status[FLAG_ZERO];
            inst_t::BPL: return !status[FLAG_NEGATIVE];
            inst_t::BMI: return status[FLAG_NEGATIVE];
            inst_t::BVC: return !status[FLAG_OVERFLOW];
            inst_t::BVS: return status[FLAG_OVERFLOW];
            default    : return 0;
        }
    }

    let _state_debug: logic<64> = debug_cpu_state_str(state);
    assign debug_pc       = reg_pc;
    assign logic_analizer = {!stall && !halt && state == cpu_state_t::DECODE, reg_pc[6:0], cpubus.rdata,};

    always_comb {
        cpubus.addr  = 0;
        cpubus.wen   = 0;
        cpubus.wdata = 0;

        case (state) {
            cpu_state_t::RESET0: {
                cpubus.addr = RESET_VECTOR;
            }
            cpu_state_t::RESET1: {
                cpubus.addr = RESET_VECTOR + 1;
            }
            cpu_state_t::FETCH: {
                cpubus.addr = reg_pc;
                if (nmi_pending) {
                    cpubus.addr  = {8'h01, reg_sp};
                    cpubus.wdata = reg_pc[15:8];
                    cpubus.wen   = 1'b1;
                }
            }
            cpu_state_t::DECODE: {
                let decode_entry: decode_entry_t = decode_opcode(cpubus.rdata);
                case (decode_entry.mode) {
                    addr_mode_t::IMPLIED: {
                        case (decode_entry.inst_kind) {
                            inst_t::BRK: {
                                let brk_return_addr: logic<16> = reg_pc + decode_entry.len;
                                cpubus.addr     = {8'h01, reg_sp};
                                cpubus.wdata    = brk_return_addr[15:8];
                                cpubus.wen      = 1'b1;
                            }
                            inst_t::PLP, inst_t::PLA, inst_t::RTI, inst_t::RTS: {
                                cpubus.addr = {8'h01, reg_sp + 8'd1};
                            }
                            inst_t::PHA: {
                                cpubus.addr  = {8'h01, reg_sp};
                                cpubus.wdata = reg_a;
                                cpubus.wen   = 1'b1;
                            }
                            inst_t::PHP: {
                                cpubus.addr  = {8'h01, reg_sp};
                                cpubus.wdata = reg_p | 8'h30;
                                cpubus.wen   = 1'b1;
                            }
                        }
                    }
                    addr_mode_t::IMM, addr_mode_t::ZP, addr_mode_t::ZPX, addr_mode_t::ZPY, addr_mode_t::INDX,
                    addr_mode_t::INDY, addr_mode_t::REL, addr_mode_t::ABS, addr_mode_t::ABSX, addr_mode_t::ABSY,
                    addr_mode_t::IND: {
                        cpubus.addr = reg_pc + 1;
                    }
                }
            }
            cpu_state_t::OP1: {
                case (addr_mode) {
                    addr_mode_t::ZP, addr_mode_t::ZPX, addr_mode_t::ZPY: {
                        let index      : logic<8> = if addr_mode == addr_mode_t::ZPX ?
                            reg_x
                        : if addr_mode == addr_mode_t::ZPY ?
                            reg_y
                        :
                            0
                        ;
                        cpubus.addr = zero_page_addr(cpubus.rdata, index);
                    }
                    addr_mode_t::INDX: {
                        cpubus.addr = zero_page_addr(cpubus.rdata, reg_x);
                    }
                    addr_mode_t::INDY: {
                        cpubus.addr = zero_page_addr(cpubus.rdata, 0);
                    }
                    addr_mode_t::ABS, addr_mode_t::ABSX, addr_mode_t::ABSY, addr_mode_t::IND: {
                        cpubus.addr = reg_pc + 2;
                    }
                }
            }
            cpu_state_t::OP2: {
                case (addr_mode) {
                    addr_mode_t::INDX, addr_mode_t::INDY: {
                        cpubus.addr = zero_page_addr(ptr_addr, 1);
                    }
                    addr_mode_t::ABS, addr_mode_t::ABSX, addr_mode_t::ABSY: {
                        if (!is_store_inst(decoded_inst)) {
                            cpubus.addr = indexed_addr(addr_mode, {cpubus.rdata, op1}, reg_x, reg_y);
                        }
                    }
                    addr_mode_t::IND: {
                        cpubus.addr = {cpubus.rdata, op1};
                    }
                }
            }
            cpu_state_t::OP3: {
                case (addr_mode) {
                    addr_mode_t::INDX: {
                        if (!is_store_inst(decoded_inst)) {
                            cpubus.addr = {cpubus.rdata, op1};
                        }
                    }
                    addr_mode_t::INDY: {
                        if (!is_store_inst(decoded_inst)) {
                            cpubus.addr = {cpubus.rdata, op1} + reg_y;
                        }
                    }
                }
            }
            cpu_state_t::JMP_IND_LO: {
                cpubus.addr = {return_addr[15:8], return_addr[7:0] + 8'd1};
            }
            cpu_state_t::EXEC: {
                case (decoded_inst) {
                    inst_t::JSR: {
                        cpubus.addr  = {8'h01, reg_sp};
                        cpubus.wdata = high_byte(reg_pc + 16'd2);
                        cpubus.wen   = 1'b1;
                    }
                    inst_t::INC, inst_t::DEC, inst_t::ASL, inst_t::LSR, inst_t::ROL, inst_t::ROR: {
                        cpubus.addr  = eff_addr;
                        cpubus.wdata = cpubus.rdata;
                        cpubus.wen   = 1'b1;
                    }
                    inst_t::STA, inst_t::STX, inst_t::STY: {
                        cpubus.addr = eff_addr;
                        case (decoded_inst) {
                            inst_t::STA: cpubus.wdata = reg_a;
                            inst_t::STX: cpubus.wdata = reg_x;
                            inst_t::STY: cpubus.wdata = reg_y;
                        }
                        cpubus.wen = 1'b1;
                    }
                }
            }
            cpu_state_t::RMW_WRITE: {
                cpubus.addr  = eff_addr;
                cpubus.wdata = op2;
                cpubus.wen   = 1'b1;
            }
            cpu_state_t::INT_PUSH_LO: {
                cpubus.addr  = {8'h01, reg_sp};
                cpubus.wdata = return_addr[7:0];
                cpubus.wen   = 1'b1;
            }
            cpu_state_t::INT_PUSH_P: {
                cpubus.addr  = {8'h01, reg_sp};
                cpubus.wdata = interrupt_status;
                cpubus.wen   = 1'b1;
            }
            cpu_state_t::INT_VECTOR_LO: {
                cpubus.addr = interrupt_vector;
            }
            cpu_state_t::INT_VECTOR_HI: {
                cpubus.addr = interrupt_vector + 16'd1;
            }
            cpu_state_t::JSR_PUSH_LO: {
                cpubus.addr  = {8'h01, reg_sp};
                cpubus.wdata = return_addr[7:0];
                cpubus.wen   = 1'b1;
            }
            cpu_state_t::RTI_PULL_P: {
                cpubus.addr = {8'h01, reg_sp + 8'd2};
            }
            cpu_state_t::RTI_WAIT_LO: {
                cpubus.addr = {8'h01, reg_sp + 8'd2};
            }
            cpu_state_t::RTS_PULL_LO: {
                cpubus.addr = {8'h01, reg_sp + 8'd2};
            }
            cpu_state_t::RTS_WAIT_HI: {
                cpubus.addr = {8'h01, reg_sp + 8'd1};
            }
        }

        // CPU状態を保持している間は、同じ書き込みサイクルを再発行しない。
        if (stall || halt) {
            cpubus.wen = 0;
        }
    }

    always_ff {
        if_reset {
            state            = cpu_state_t::RESET0;
            reg_a            = 0;
            reg_x            = 0;
            reg_y            = 0;
            reg_sp           = 8'hFD;
            reg_p            = 8'h24; // bit[5]=1,bit[2]=1
            reg_pc           = 0;
            op1              = 0;
            op2              = 0;
            ptr_addr         = 0;
            eff_addr         = 0;
            return_addr      = 0;
            interrupt_vector = 0;
            interrupt_status = 0;
            inst_len         = 0;
            nmi_d            = 0;
            nmi_pending      = 0;
            decoded_inst     = inst_t::INVALID;
            addr_mode        = addr_mode_t::IMPLIED;
        } else {
            // NMIは1clkパルスなので立ち上がりを検出して命令境界まで保持する
            nmi_pending = nmi_pending || (nmi && !nmi_d);
            nmi_d       = nmi;

            if (!stall && !halt) {
                case state {
                    // 0xFFFCをセット
                    cpu_state_t::RESET0: {
                        state = cpu_state_t::RESET1;
                    }
                    // RESET0でセットした0xFFFCのデータが反映されるので読む
                    cpu_state_t::RESET1: {
                        reg_pc[7:0] = cpubus.rdata;
                        state       = cpu_state_t::RESET2;
                    }
                    // RESET1でセットした0xFFFDのデータが反映されるので読む
                    cpu_state_t::RESET2: {
                        reg_pc[15:8] = cpubus.rdata;
                        state        = cpu_state_t::FETCH;
                    }
                    // PCを読み込む。opcodeは次のDECODEで受け取る。
                    cpu_state_t::FETCH: {
                        if (nmi_pending) {
                            nmi_pending      = 0;
                            return_addr      = reg_pc;
                            interrupt_vector = NMI_VECTOR;
                            interrupt_status = reg_p & 8'hEF | 8'h20;
                            reg_sp           = reg_sp - 1;
                            state            = cpu_state_t::INT_PUSH_LO;
                        } else {
                            state = cpu_state_t::DECODE;
                        }
                    }
                    cpu_state_t::DECODE: {
                        let decode_entry: decode_entry_t = decode_opcode(cpubus.rdata);
                        decoded_inst = decode_entry.inst_kind;
                        addr_mode    = decode_entry.mode;
                        inst_len     = decode_entry.len;

                        if (decode_entry.inst_kind == inst_t::INVALID) {} else {
                            case (decode_entry.mode) {
                                addr_mode_t::IMPLIED: {
                                    case (decode_entry.inst_kind) {
                                        inst_t::BRK: {
                                            let brk_return_addr : logic<16> = reg_pc + decode_entry.len;
                                            return_addr      = brk_return_addr;
                                            interrupt_vector = IRQ_VECTOR;
                                            interrupt_status = reg_p | 8'h10;
                                            reg_sp           = reg_sp - 1;
                                            state            = cpu_state_t::INT_PUSH_LO;
                                        }

                                        inst_t::PLP: {
                                            state = cpu_state_t::EXEC;
                                        }

                                        inst_t::PLA: {
                                            state = cpu_state_t::EXEC;
                                        }

                                        inst_t::RTI: {
                                            state = cpu_state_t::RTI_PULL_P;
                                        }

                                        inst_t::PHA: {
                                            reg_sp = reg_sp - 1;
                                            reg_pc = reg_pc + decode_entry.len;
                                            state  = cpu_state_t::FETCH;
                                        }

                                        inst_t::PHP: {
                                            reg_sp = reg_sp - 1;
                                            reg_pc = reg_pc + decode_entry.len;
                                            state  = cpu_state_t::FETCH;
                                        }

                                        // NMIはIフラグに関係なく受け付ける。
                                        inst_t::SEI, inst_t::CLI, inst_t::SEC, inst_t::CLC, inst_t::SED, inst_t::CLD,
                                        inst_t::CLV: {
                                            reg_p  = status_after_flag_inst(decode_entry.inst_kind, reg_p);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::NOP: {
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TXS: {
                                            reg_sp = reg_x;
                                            // TXSはフラグ更新しない
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TSX: {
                                            reg_x  = reg_sp;
                                            reg_p  = update_zn(reg_p, reg_sp);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TAX: {
                                            reg_x  = reg_a;
                                            reg_p  = update_zn(reg_p, reg_a);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TXA: {
                                            reg_a  = reg_x;
                                            reg_p  = update_zn(reg_p, reg_x);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TAY: {
                                            reg_y  = reg_a;
                                            reg_p  = update_zn(reg_p, reg_a);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::TYA: {
                                            reg_a  = reg_y;
                                            reg_p  = update_zn(reg_p, reg_y);
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::ASL, inst_t::LSR, inst_t::ROL, inst_t::ROR: {
                                            let result: alu_result_t = alu_execute(
                                                decode_entry.inst_kind,
                                                reg_a,
                                                0,
                                                reg_p,
                                            );
                                            reg_a  = result.value;
                                            reg_p  = result.status;
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::INX, inst_t::INY, inst_t::DEX, inst_t::DEY: {
                                            let old_value: logic       <8> = if decode_entry.inst_kind == inst_t::INX
                                                || decode_entry.inst_kind == inst_t::DEX ?
                                                reg_x
                                            :
                                                reg_y
                                            ;
                                            let result   : alu_result_t    = alu_execute(
                                                decode_entry.inst_kind,
                                                old_value,
                                                0,
                                                reg_p,
                                            );
                                            if (decode_entry.inst_kind == inst_t::INX || decode_entry.inst_kind
                                                == inst_t::DEX) {
                                                reg_x = result.value;
                                            } else {
                                                reg_y = result.value;
                                            }
                                            reg_p  = result.status;
                                            state  = cpu_state_t::FETCH;
                                            reg_pc = reg_pc + decode_entry.len;
                                        }

                                        inst_t::RTS: {
                                            state = cpu_state_t::RTS_PULL_LO;
                                        }

                                        default: {
                                            state = cpu_state_t::FETCH;
                                        }
                                    }
                                }
                                addr_mode_t::IMM, addr_mode_t::ZP, addr_mode_t::ZPX, addr_mode_t::ZPY,
                                addr_mode_t::INDX, addr_mode_t::INDY, addr_mode_t::REL, addr_mode_t::ABS,
                                addr_mode_t::ABSX, addr_mode_t::ABSY, addr_mode_t::IND: {
                                    state = cpu_state_t::OP1;
                                }
                                default: {
                                    state = cpu_state_t::FETCH;
                                }
                            }
                        }
                    }

                    cpu_state_t::OP1: {
                        case (addr_mode) {
                            addr_mode_t::IMM, addr_mode_t::REL: {
                                op1   = cpubus.rdata;
                                state = cpu_state_t::EXEC;
                            }
                            addr_mode_t::ZP, addr_mode_t::ZPX, addr_mode_t::ZPY: {
                                let index   : logic<8> = if addr_mode == addr_mode_t::ZPX ?
                                    reg_x
                                : if addr_mode == addr_mode_t::ZPY ?
                                    reg_y
                                :
                                    0
                                ;
                                op1      = cpubus.rdata;
                                eff_addr = zero_page_addr(cpubus.rdata, index);
                                state    = cpu_state_t::EXEC;
                            }
                            addr_mode_t::INDX: {
                                op1      = cpubus.rdata;
                                ptr_addr = cpubus.rdata + reg_x;
                                state    = cpu_state_t::OP2;
                            }
                            addr_mode_t::INDY: {
                                op1      = cpubus.rdata;
                                ptr_addr = cpubus.rdata;
                                state    = cpu_state_t::OP2;
                            }
                            addr_mode_t::ABS, addr_mode_t::ABSX, addr_mode_t::ABSY, addr_mode_t::IND: {
                                op1   = cpubus.rdata;
                                state = cpu_state_t::OP2;
                            }
                            default: {
                                state = cpu_state_t::FETCH;
                            }
                        }
                    }

                    cpu_state_t::OP2: {
                        case (addr_mode) {
                            addr_mode_t::INDX, addr_mode_t::INDY: {
                                op1   = cpubus.rdata;
                                state = cpu_state_t::OP3;
                            }
                            addr_mode_t::ABS, addr_mode_t::ABSX, addr_mode_t::ABSY: {
                                eff_addr = indexed_addr(addr_mode, {cpubus.rdata, op1}, reg_x, reg_y);
                                if (decoded_inst == inst_t::JMP) {
                                    reg_pc = {cpubus.rdata, op1};
                                    state  = cpu_state_t::FETCH;
                                } else {
                                    state = cpu_state_t::EXEC;
                                }
                            }
                            addr_mode_t::IND: {
                                return_addr = {cpubus.rdata, op1};
                                state       = cpu_state_t::JMP_IND_LO;
                            }
                            default: {
                                state = cpu_state_t::FETCH;
                            }
                        }
                    }

                    cpu_state_t::OP3: {
                        case (addr_mode) {
                            addr_mode_t::INDX, addr_mode_t::INDY: {
                                eff_addr = indexed_addr(addr_mode, {cpubus.rdata, op1}, reg_x, reg_y);
                                state    = cpu_state_t::EXEC;
                            }
                            default: {
                                state = cpu_state_t::FETCH;
                            }
                        }
                    }

                    cpu_state_t::JMP_IND_LO: {
                        op1 = cpubus.rdata;
                        // 6502のJMP ($xxFF)バグ: high byteは次ページではなく同じページの$xx00から読む
                        state = cpu_state_t::JMP_IND_HI;
                    }

                    cpu_state_t::JMP_IND_HI: {
                        reg_pc = {cpubus.rdata, op1};
                        state  = cpu_state_t::FETCH;
                    }

                    cpu_state_t::EXEC: {
                        let exec_data    : logic       <8>  = if addr_mode == addr_mode_t::IMM || addr_mode
                            == addr_mode_t::REL ?
                            op1
                        :
                            cpubus.rdata
                        ;
                        let branch_offset: signed logic<16> = {exec_data[7] repeat 8, exec_data};
                        case (decoded_inst) {
                            // 8種類の分岐命令は、参照するフラグだけが異なる。
                            inst_t::BCC, inst_t::BCS, inst_t::BNE, inst_t::BEQ, inst_t::BPL, inst_t::BMI, inst_t::BVC,
                            inst_t::BVS: {
                                if (branch_taken(decoded_inst, reg_p)) {
                                    reg_pc = reg_pc + 16'd2 + branch_offset;
                                } else {
                                    reg_pc = reg_pc + 16'd2;
                                }
                                state = cpu_state_t::FETCH;
                            }

                            inst_t::JMP: {
                                reg_pc = eff_addr;
                                state  = cpu_state_t::FETCH;
                            }

                            inst_t::JSR: {
                                return_addr = reg_pc + 16'd2;
                                reg_sp      = reg_sp - 1;
                                state       = cpu_state_t::JSR_PUSH_LO;
                            }

                            inst_t::PLP: {
                                reg_p  = exec_data | 8'h20;
                                reg_sp = reg_sp + 1;
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }

                            inst_t::PLA: {
                                reg_a  = exec_data;
                                reg_p  = update_zn(reg_p, exec_data);
                                reg_sp = reg_sp + 1;
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }

                            inst_t::LDA, inst_t::LDX, inst_t::LDY: {
                                case (decoded_inst) {
                                    inst_t::LDA: reg_a = exec_data;
                                    inst_t::LDX: reg_x = exec_data;
                                    inst_t::LDY: reg_y = exec_data;
                                }
                                reg_p  = update_zn(reg_p, exec_data);
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }
                            inst_t::CMP, inst_t::CPX, inst_t::CPY: {
                                let left  : logic       <8> = if decoded_inst == inst_t::CMP ?
                                    reg_a
                                : if decoded_inst == inst_t::CPX ?
                                    reg_x
                                :
                                    reg_y
                                ;
                                let result: alu_result_t    = alu_execute(decoded_inst, left, exec_data, reg_p);
                                reg_p  = result.status;
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }
                            inst_t::ADC, inst_t::SBC, inst_t::ORA, inst_t::AND, inst_t::EOR: {
                                let result: alu_result_t = alu_execute(decoded_inst, reg_a, exec_data, reg_p);
                                reg_a  = result.value;
                                reg_p  = result.status;
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }
                            inst_t::INC, inst_t::DEC: {
                                let result: alu_result_t = alu_execute(decoded_inst, exec_data, 0, reg_p);
                                op2    = result.value;
                                reg_p  = result.status;
                                state  = cpu_state_t::RMW_WRITE;
                            }
                            inst_t::ASL, inst_t::LSR, inst_t::ROL, inst_t::ROR: {
                                let result: alu_result_t = alu_execute(decoded_inst, exec_data, 0, reg_p);
                                op2    = result.value;
                                reg_p  = result.status;
                                state  = cpu_state_t::RMW_WRITE;
                            }
                            inst_t::BIT: {
                                let result: alu_result_t = alu_execute(decoded_inst, reg_a, exec_data, reg_p);
                                reg_p  = result.status;
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }
                            inst_t::STA, inst_t::STX, inst_t::STY: {
                                reg_pc = reg_pc + inst_len;
                                state  = cpu_state_t::FETCH;
                            }
                            default: {
                                state = cpu_state_t::FETCH;
                            }
                        }
                    }
                    cpu_state_t::RMW_WRITE: {
                        reg_pc = reg_pc + inst_len;
                        state  = cpu_state_t::FETCH;
                    }
                    cpu_state_t::INT_PUSH_LO: {
                        reg_sp = reg_sp - 1;
                        state  = cpu_state_t::INT_PUSH_P;
                    }
                    cpu_state_t::INT_PUSH_P: {
                        reg_sp                = reg_sp - 1;
                        reg_p[FLAG_INTERRUPT] = 1'b1;
                        state                 = cpu_state_t::INT_VECTOR_LO;
                    }
                    cpu_state_t::INT_VECTOR_LO: {
                        state = cpu_state_t::INT_VECTOR_LO_WAIT;
                    }
                    cpu_state_t::INT_VECTOR_LO_WAIT: {
                        op1   = cpubus.rdata;
                        state = cpu_state_t::INT_VECTOR_HI;
                    }
                    cpu_state_t::INT_VECTOR_HI: {
                        state = cpu_state_t::INT_VECTOR_HI_READ;
                    }
                    cpu_state_t::INT_VECTOR_HI_READ: {
                        reg_pc = {cpubus.rdata, op1};
                        state  = cpu_state_t::FETCH;
                    }
                    cpu_state_t::JSR_PUSH_LO: {
                        reg_sp = reg_sp - 1;
                        reg_pc = eff_addr;
                        state  = cpu_state_t::FETCH;
                    }
                    cpu_state_t::RTI_PULL_P: {
                        reg_p  = cpubus.rdata | 8'h20;
                        reg_sp = reg_sp + 1;
                        state  = cpu_state_t::RTI_WAIT_LO;
                    }
                    cpu_state_t::RTI_WAIT_LO: {
                        op1    = cpubus.rdata;
                        reg_sp = reg_sp + 1;
                        state  = cpu_state_t::RTI_PULL_HI;
                    }
                    cpu_state_t::RTI_PULL_HI: {
                        reg_sp = reg_sp + 1;
                        reg_pc = {cpubus.rdata, op1};
                        state  = cpu_state_t::FETCH;
                    }
                    cpu_state_t::RTS_PULL_LO: {
                        op1    = cpubus.rdata;
                        reg_sp = reg_sp + 1;
                        state  = cpu_state_t::RTS_WAIT_HI;
                    }
                    cpu_state_t::RTS_WAIT_HI: {
                        reg_sp = reg_sp + 1;
                        reg_pc = {cpubus.rdata, op1} + 16'd1;
                        state  = cpu_state_t::FETCH;
                    }
                    default: {
                        state = cpu_state_t::RESET0;
                    }
                }
            }
        }
    }
}
