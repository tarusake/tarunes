/// CPUから見えるNESコントローラのシリアル読み出しレジスタ。
///
/// CPU側では`$4016`が1P、`$4017`の読み出しが2Pに対応する。
/// 読み出し値はbit 0だけを使用し、bit 7～1は0を返す。入力の
/// `controller*_btns`はbit 0から順にA、B、Select、Start、上、下、左、右。
///
/// `$4016`のbit 0へ1を書き込むとストローブが立ち、ボタン状態を取り込む。
/// ストローブが1の間は毎サイクル入力を取り込み、読出位置を先頭に戻す。
/// 0を書き込んだ後は、各ポートの読み出しで下位ビットから順に返し、
/// 読出位置を進める。8ビットを読み終えた後は1を返す。
///
/// 読出位置が進むのは`sel`の立ち上がりで検出した読み出し時だけ。
/// `stall`中は読み出しデータと内部状態を保持する。現在のバスには
/// 読み出し許可信号がないため、`sel`を維持した連続読み出しでは
/// 毎回シフトされるわけではない。
pub module controller (
    clk             : input   clock                   ,
    rst             : input   reset                   ,
    stall           : input   logic                   ,
    sel             : input   logic                   ,
    controller1_btns: input   logic                <8>,
    controller2_btns: input   logic                <8>,
    cpubus          : modport bus_if::<8, 1>::slave   ,
) {
    var strobe    : logic   ;
    var shift1    : logic<8>;
    var shift2    : logic<8>;
    var count1    : logic<4>;
    var count2    : logic<4>;
    var sel_d     : logic   ;
    var read_pulse: logic   ;

    // TODO: bus_ifにread enableを追加したら、sel立ち上がりではなく
    // CPUの実readサイクル1回だけでシフトするように置き換える。
    assign read_pulse = sel && !sel_d && !cpubus.wen;

    always_ff {
        if_reset {
            cpubus.rdata = 0;
            strobe       = 0;
            shift1       = 0;
            shift2       = 0;
            count1       = 0;
            count2       = 0;
            sel_d        = 0;
        } else if !stall {
            sel_d = sel;

            if (strobe) {
                shift1 = controller1_btns;
                shift2 = controller2_btns;
                count1 = 0;
                count2 = 0;
            }

            if (sel && cpubus.wen && cpubus.addr == 0) {
                strobe = cpubus.wdata[0];
                if (cpubus.wdata[0]) {
                    shift1 = controller1_btns;
                    shift2 = controller2_btns;
                    count1 = 0;
                    count2 = 0;
                }
            } else if (sel && !cpubus.wen) {
                case (cpubus.addr) {
                    0: {
                        let read1_bit   : logic    = if count1 <: 8 ? shift1[0] : 1'b1;
                        let read1_data  : logic<8> = {7'b0000000, read1_bit};
                        cpubus.rdata = read1_data;
                        if (read_pulse && !strobe && count1 <: 8) {
                            shift1 = {1'b1, shift1[7:1]};
                            count1 = count1 + 1;
                        }
                    }
                    1: {
                        cpubus.rdata = {7'b0000000, if count2 <: 8 ? shift2[0] : 1'b1};
                        if (read_pulse && !strobe && count2 <: 8) {
                            shift2 = {1'b1, shift2[7:1]};
                            count2 = count2 + 1;
                        }
                    }
                    default: {
                        cpubus.rdata = 0;
                    }
                }
            }
        }
    }
}
