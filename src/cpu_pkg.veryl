/// Shared 6502 instruction decoding definitions.
package cpu_pkg {
    const FLAG_CARRY    : u32 = 0;
    const FLAG_ZERO     : u32 = 1;
    const FLAG_INTERRUPT: u32 = 2;
    const FLAG_DECIMAL  : u32 = 3;
    const FLAG_BREAK    : u32 = 4;
    const FLAG_UNUSED   : u32 = 5;
    const FLAG_OVERFLOW : u32 = 6;
    const FLAG_NEGATIVE : u32 = 7;

    enum inst_t {
        INVALID,
        BRK,
        RTI,
        PHA,
        PLA,
        PHP,
        PLP,
        SEI,
        SEC,
        CLI,
        CLD,
        CLC,
        SED,
        CLV,
        NOP,
        TXS,
        TSX,
        TAX,
        TXA,
        TAY,
        TYA,
        INX,
        INY,
        INC,
        DEC,
        ASL,
        LSR,
        ROL,
        ROR,
        DEX,
        DEY,
        LDA,
        LDX,
        LDY,
        CPX,
        CPY,
        CMP,
        ADC,
        SBC,
        ORA,
        AND,
        EOR,
        STA,
        STX,
        STY,
        BIT,
        BCC,
        BCS,
        BNE,
        BEQ,
        BPL,
        BMI,
        BVC,
        BVS,
        JMP,
        JSR,
        RTS,
    }
    enum addr_mode_t {
        IMPLIED,
        IMM,
        ZP,
        ZPX,
        ZPY,
        ABS,
        ABSX,
        ABSY,
        IND,
        INDX,
        INDY,
        REL,
    }
    struct decode_entry_t {
        opcode   : logic      <8> ,
        inst_kind: inst_t         ,
        mode     : addr_mode_t    ,
        len      : logic      <16>,
    }
