module hdmi_480p_scaler (
    clk             : input  clock    ,
    rst             : input  reset    ,
    core_cycle      : input  logic<9> ,
    core_scanline   : input  logic<9> ,
    core_pixel_index: input  logic<6> ,
    hdmi_r          : output logic<8> ,
    hdmi_g          : output logic<8> ,
    hdmi_b          : output logic<8> ,
    hdmi_hsync      : output logic    ,
    hdmi_vsync      : output logic    ,
    hdmi_de         : output logic    ,
    video_x         : output logic<10>,
    video_y         : output logic<10>,
) {
    const FB_WIDTH          : u32       = 256;
    const FB_HEIGHT         : u32       = 240;
    const FB_PIXELS         : u32       = FB_WIDTH * FB_HEIGHT;
    const H_ACTIVE          : logic<10> = 10'd720;
    const H_FRONT_PORCH     : logic<10> = 10'd16;
    const H_SYNC            : logic<10> = 10'd62;
    const H_TOTAL           : logic<10> = 10'd858;
    const V_ACTIVE          : logic<10> = 10'd480;
    const V_FRONT_PORCH     : logic<10> = 10'd9;
    const V_SYNC            : logic<10> = 10'd6;
    const V_TOTAL           : logic<10> = 10'd525;
    const X_OFFSET          : logic<10> = 10'd104;
    const SCALED_WIDTH      : logic<10> = 10'd512;
    const BORDER_COLOR_INDEX: logic<6>  = 6'd1;
    const BORDER_RGB        : logic<24> = 24'h003DA6;

    var framebuffer: logic<6> [FB_PIXELS];

    const NES_PALETTE: logic<24> [64] = '{
        24'h808080, 24'h003DA6, 24'h0012B0, 24'h440096, 24'hA1005E, 24'hC70028, 24'hBA0600, 24'h8C1700, 24'h5C2F00,
        24'h104500, 24'h054A00, 24'h00472E, 24'h004166, 24'h000000, 24'h050505, 24'h050505, 24'hC7C7C7, 24'h0077FF,
        24'h2155FF, 24'h8237FA, 24'hEB2FB5, 24'hFF2950, 24'hFF2200, 24'hD63200, 24'hC46200, 24'h358000, 24'h058F00,
        24'h008A55, 24'h0099CC, 24'h212121, 24'h090909, 24'h090909, 24'hFFFFFF, 24'h0FD7FF, 24'h69A2FF, 24'hD480FF,
        24'hFF45F3, 24'hFF618B, 24'hFF8833, 24'hFF9C12, 24'hFABC20, 24'h9FE30E, 24'h2BF035, 24'h0CF0A4, 24'h05FBFF,
        24'h5E5E5E, 24'h0D0D0D, 24'h0D0D0D, 24'hFFFFFF, 24'hA6FCFF, 24'hB3ECFF, 24'hDAABEB, 24'hFFA8F9, 24'hFFABB3,
        24'hFFD2B0, 24'hFFEFA6, 24'hFFF79C, 24'hD7E895, 24'hA6EDAF, 24'hA2F2DA, 24'h99FFFC, 24'hDDDDDD, 24'h111111,
        24'h111111
    };

    var core_visible  : logic    ;
    var write_addr    : logic<16>;
    var h_count       : logic<10>;
    var v_count       : logic<10>;
    var read_addr     : logic<16>;
    var read_pixel    : logic<6> ;
    var read_rgb      : logic<24>;
    var read_de       : logic    ;
    var read_border   : logic    ;
    var read_x        : logic<10>;
    var read_y        : logic<10>;
    var active_area   : logic    ;
    var scaled_area   : logic    ;
    var scaled_x      : logic<10>;
    var src_x         : logic<8> ;
    var src_y         : logic<8> ;
    var next_read_addr: logic<16>;

    assign core_visible   = core_cycle <: 9'd256 && core_scanline <: 9'd240;
    assign write_addr     = {core_scanline[7:0], 8'b0} + {8'b0, core_cycle[7:0]};
    assign active_area    = h_count <: H_ACTIVE && v_count <: V_ACTIVE;
    assign scaled_area    = active_area && h_count >= X_OFFSET && h_count <: X_OFFSET + SCALED_WIDTH;
    assign scaled_x       = h_count - X_OFFSET;
    assign src_x          = scaled_x[8:1];
    assign src_y          = v_count[8:1];
    assign next_read_addr = {src_y, 8'b0} + {8'b0, src_x};
    assign read_rgb       = NES_PALETTE[read_pixel];

    always_ff {
        if core_visible {
            framebuffer[write_addr] = core_pixel_index;
        }
    }

    always_ff {
        if_reset {
            h_count     = 0;
            v_count     = 0;
            read_addr   = 0;
            read_pixel  = 0;
            read_de     = 0;
            read_border = 0;
            read_x      = 0;
            read_y      = 0;
            hdmi_r      = 0;
            hdmi_g      = 0;
            hdmi_b      = 0;
            hdmi_hsync  = 1;
            hdmi_vsync  = 1;
            hdmi_de     = 0;
            video_x     = 0;
            video_y     = 0;
        } else {
            if h_count == H_TOTAL - 10'd1 {
                h_count = 0;
                if v_count == V_TOTAL - 10'd1 {
                    v_count = 0;
                } else {
                    v_count = v_count + 1;
                }
            } else {
                h_count = h_count + 1;
            }

            read_addr   = if scaled_area ? next_read_addr : 16'd0;
            read_pixel  = if scaled_area ? framebuffer[read_addr] : BORDER_COLOR_INDEX;
            read_de     = active_area;
            read_border = active_area && !scaled_area;
            read_x      = h_count;
            read_y      = v_count;

            if read_de {
                hdmi_r = if read_border ? BORDER_RGB[23:16] : read_rgb[23:16];
                hdmi_g = if read_border ? BORDER_RGB[15:8] : read_rgb[15:8];
                hdmi_b = if read_border ? BORDER_RGB[7:0] : read_rgb[7:0];
            } else {
                hdmi_r = 8'd0;
                hdmi_g = 8'd0;
                hdmi_b = 8'd0;
            }

            hdmi_de    = read_de;
            video_x    = read_x;
            video_y    = read_y;
            hdmi_hsync = !(h_count >= H_ACTIVE + H_FRONT_PORCH && h_count <: H_ACTIVE + H_FRONT_PORCH + H_SYNC);
            hdmi_vsync = !(v_count >= V_ACTIVE + V_FRONT_PORCH && v_count <: V_ACTIVE + V_FRONT_PORCH + V_SYNC);
        }
    }
}
