/// Shared PPU register, OAM, address, and scrolling definitions.
package ppu_pkg {
    struct ppu_ctrl_t {
        nmi_enable              : logic   ,
        master_slave            : logic   ,
        sprite_size             : logic   ,
        background_pattern_table: logic   ,
        sprite_pattern_table    : logic   ,
        vram_increment          : logic   ,
        base_nametable          : logic<2>,
    }

    struct ppu_mask_t {
        emphasize_blue      : logic,
        emphasize_green     : logic,
        emphasize_red       : logic,
        show_sprites        : logic,
        show_background     : logic,
        show_sprites_left   : logic,
        show_background_left: logic,
        greyscale           : logic,
    }

    struct ppu_status_t {
        vblank         : logic   ,
        sprite0_hit    : logic   ,
        sprite_overflow: logic   ,
        open_bus       : logic<5>,
    }

    struct oam_t {
        y   : logic<8>,
        tile: logic<8>,
        attr: logic<8>,
        x   : logic<8>,
    }

    const PPUCTRL_ADDR  : logic<3> = 3'd0;
    const PPUMASK_ADDR  : logic<3> = 3'd1;
    const PPUSTATUS_ADDR: logic<3> = 3'd2;
    const OAMADDR_ADDR  : logic<3> = 3'd3;
    const OAMDATA_ADDR  : logic<3> = 3'd4;
    const PPUSCROLL_ADDR: logic<3> = 3'd5;
    const PPUADDR_ADDR  : logic<3> = 3'd6;
    const PPUDATA_ADDR  : logic<3> = 3'd7;

    // パレット背景色 $3F10/$14/$18/$1C は $3F00/$04/$08/$0C のミラー。
    function palette_addr (
        addr: input logic<5>,
    ) -> logic<5> {
        if (addr == 5'h10 || addr == 5'h14 || addr == 5'h18 || addr == 5'h1C) {
            return addr - 5'h10;
        } else {
            return addr;
        }
    }

    function is_palette_addr (
        addr: input logic<16>,
    ) -> logic {
        return addr[15:8] == 8'h3F;
    }

    function bg_nt_addr (
        v: input logic<16>,
    ) -> logic<14> {
        return 14'h2000 + v[11:0];
    }

    function bg_attr_addr (
        v: input logic<16>,
    ) -> logic<14> {
        return 14'h23C0 + {2'b00, v[11:10], 10'h000} + {5'b00000, v[9:7], 3'b000} + {7'b0000000, v[4:2]};
    }

    function increment_bg_x (
        v: input logic<16>,
    ) -> logic<16> {
        var ret: logic<16>;
        ret = v;
        if (ret[4:0] == 5'd31) {
            ret[4:0] = 0;
            ret[10]  = ~ret[10];
        } else {
            ret[4:0] = ret[4:0] + 1;
        }
        return ret;
    }

    function increment_bg_y (
        v: input logic<16>,
    ) -> logic<16> {
        var ret: logic<16>;
        ret = v;
        if (ret[14:12] != 3'd7) {
            ret[14:12] = ret[14:12] + 1;
        } else {
            ret[14:12] = 0;
            if (ret[9:5] == 5'd29) {
                ret[9:5] = 0;
                ret[11]  = ~ret[11];
            } else if (ret[9:5] == 5'd31) {
                ret[9:5] = 0;
            } else {
                ret[9:5] = ret[9:5] + 1;
            }
        }
        return ret;
    }
}
