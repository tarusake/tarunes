module top #(
    param PROM_PATH: string = "",
    param CROM_PATH: string = "",
) (
    clk             : input  clock   ,
    rst             : input  reset   ,
    controller1_btns: input  logic<8>,
    controller2_btns: input  logic<8>,
    scanline        : output logic<9>,
    cycle           : output logic<9>,
    pixel_r         : output logic<8>,
    pixel_g         : output logic<8>,
    pixel_b         : output logic<8>,
    audio_sample    : output logic<8>,
) {
    inst cpubus    : bus_if::<8, 16>;
    inst cpu_ppubus: bus_if::<8, 3>;
    inst apubus    : bus_if::<8, 5>;
    inst ctrlbus   : bus_if::<8, 1>;
    inst wrambus   : bus_if::<8, 11>;
    inst prombus   : bus_if::<8, 15>;
    var nmi     : logic;
    var ctrl_sel: logic;

    inst ppubus : bus_if::<8, 14>;
    inst vrambus: bus_if::<8, 11>;
    inst crombus: bus_if::<8, 13>;

    inst cpu_inst: cpu ( clk: clk, rst: rst, nmi: nmi, cpubus: cpubus );

    inst wram: memory::<8, 11> ( clk: clk, rst: rst, membus: wrambus );

    inst prom: memory::<8, 15> #( PATH: PROM_PATH ) ( clk: clk, rst: rst, membus: prombus );

    inst ubus_cpu: bus_cpu (
        clk       : clk       ,
        rst       : rst       ,
        cpubus    : cpubus    ,
        cpu_ppubus: cpu_ppubus,
        apubus    : apubus    ,
        ctrlbus   : ctrlbus   ,
        prombus   : prombus   ,
        wrambus   : wrambus   ,
    );

    inst apu_inst: apu ( clk: clk, rst: rst, cpubus: apubus, audio_sample: audio_sample );

    inst controller_inst: controller (
        clk             : clk             ,
        rst             : rst             ,
        sel             : ctrl_sel        ,
        controller1_btns: controller1_btns,
        controller2_btns: controller2_btns,
        cpubus          : ctrlbus         ,
    );

    assign ctrl_sel = cpubus.addr == 16'h4016 || (cpubus.addr == 16'h4017 && !cpubus.wen);

    inst ppu_inst: ppu (
        clk     : clk       ,
        rst     : rst       ,
        cpubus  : cpu_ppubus,
        ppubus  : ppubus    ,
        scanline: scanline  ,
        cycle   : cycle     ,
        pixel_r : pixel_r   ,
        pixel_g : pixel_g   ,
        pixel_b : pixel_b   ,
        nmi     : nmi       ,
    );

    inst ubus_ppu: bus_ppu ( clk: clk, rst: rst, ppubus: ppubus, crombus: crombus, vrambus: vrambus );

    inst vram: memory::<8, 11> ( clk: clk, rst: rst, membus: vrambus );

    inst crom: memory::<8, 13> #( PATH: CROM_PATH ) ( clk: clk, rst: rst, membus: crombus );

}
